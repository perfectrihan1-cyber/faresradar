<div class="container">
    <div class="row">
        <div class="col-xs-12 abut_bodyhead">
            <h2>Group Traveler</h2>
        </div>
        <div class="col-xs-12">
            <p>Get inspired, grab the best deals on flights, hotels, car rentals and give a flying start to your journey to your choicest destination at a price that you just can’t imagine.</p>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <div class="gt_form">
                <h3>Please Fill the Detail Below</h3>
                @if (ViewBag.msg == "1")
                {
                    <p style="color:green;">Thank you for submit your contact us request. Administrator contact will be soon.</p>
                }
                <form name="grouptravel_frm" id="grouptravel_frm" method="post" onsubmit="javascript:return frmCheck();">
                    <div class="gt_con_info">
                        <label>Origin</label>
                        <input type="text" placeholder="Origin" class="gt_con_info_box ui-autocomplete-input" name="txtFlightFrom" id="txtFlightFrom" value="@(ViewBag.fromName)" autocomplete="off">
                        <i class="fa fa-map-marker"></i>
                    </div>
                    <div class="gt_con_info">
                        <label>Destination</label>
                        <input type="text" placeholder="Destination" class="gt_con_info_box ui-autocomplete-input" name="txtFlightTo" id="txtFlightTo" value="@(ViewBag.toName)" autocomplete="off">
                        <i class="fa fa-map-marker"></i>
                    </div>
                    <div class="gt_con_info">
                        <label>Departure Date</label>
                        <input type="text" placeholder="Departure Date" class="gt_con_info_box" value="@((ViewBag.depDate!="")?ViewBag.depDate:DateTime.Now.AddDays(1).ToString("dd-MM-yyyy"))" id="flight_from_date" name="flight_from_date" />
                        <i class="fa fa-calendar"></i>
                    </div>
                    <div class="gt_con_info">
                        <label>Return Date</label>
                        <input type="text" placeholder="Return Date" class="gt_con_info_box" value="@((ViewBag.retDate!="")?ViewBag.retDate:DateTime.Now.AddDays(8).ToString("dd-MM-yyyy"))" id="flight_to_date" name="flight_to_date" />
                        <i class="fa fa-calendar"></i>
                    </div>
                    <div class="gt_mr">
                        <label>Title</label>
                        <select class="gt_mr_box">
                            <option value="Mr.">Mr.</option>
                            <option value="Mrs.">Mrs.</option>
                            <option value="Miss.">Miss.</option>
                        </select>
                    </div>
                    <div class="gt_name">
                        <label>First Name</label>
                        <input type="text" class="gt_name_box" placeholder="First Name" id="txt_fname" name="txt_fname">
                    </div>
                    <div class="gt_name">
                        <label>Last Name</label>
                        <input type="text" class="gt_name_box" placeholder="Last Name" id="txt_lname" name="txt_lname">
                    </div>
                    <div class="gt_mr">
                        <label>Traveller</label>
                        <input type="text" class="gt_mr_box" placeholder="Total" maxlength="2" id="txt_Traveller" name="txt_Traveller">
                    </div>
                    <div class="gt_name">
                        <label>Email</label>
                        <input type="text" class="gt_name_box" placeholder="Email" id="txt_email" name="txt_email">
                    </div>
                    <div class="gt_name">
                        <label>Phone</label>
                        <input type="text" class="gt_name_box" placeholder="Phone" id="txt_phone" name="txt_phone">
                    </div>
                    <div class="gt_cmmntBox">
                        <textarea class="gt_txtarea" placeholder="Message..." id="txt_message" name="txt_message"></textarea>
                    </div>
                    <div class="gt_cap_btn">
                        <div class="g-recaptcha" data-sitekey="6LdyxkYUAAAAAAF5F800JzBLvpkUrNED9EoSFBcd"></div>
                        <button type="submit" name="grouptravel_btn" id="grouptravel_btn" class="">Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 col-xs-12">
