            $("#prsn_addx").click(function () {
                $("#prsn_popupx").slideDown("slow");
            });
            $('#txtPassengers').click(function () {
                //$('i.fa').slideToggle("slow");
                $('#prsn_popupx').slideToggle("slow");
            });
            $('#prsn_donex').click(function () {
                $('#prsn_popupx').slideUp("slow");
            });


            $(".inc_derx").click(function () {
                var fld = $(this).attr("data-field");
                var fld_opt = $(this).attr("data-opt");
                var adt = parseInt($("#flight_adultx").val());
                var chd = parseInt($("#flight_childx").val());
                var inf = parseInt($("#flight_infantx").val());

                if (fld == "adult") {
                    if (fld_opt == "+") {
                        if ((adt + chd) < 9) {
                            $("#flight_adultx").val(adt + 1);
                        }
                    }
                    else if (fld_opt == "-") {
                        if (adt > 1) {
                            $("#flight_adultx").val(adt - 1);
                        }
                    }
                }
                else if (fld == "child") {
                    if (fld_opt == "+") {
                        if ((adt + chd) < 9) {
                            $("#flight_childx").val(chd + 1);
                        }
                    }
                    else if (fld_opt == "-") {
                        if (chd > 0) {
                            $("#flight_childx").val(chd - 1);
                        }
                    }
                }
                else if (fld == "infant") {
                    if (fld_opt == "+") {
                        if (adt > inf) {
                            $("#flight_infantx").val(inf + 1);
                        }
                    }
                    else if (fld_opt == "-") {
                        if (inf > 0) {
                            $("#flight_infantx").val(inf - 1);
                        }
                    }
                }

                getPassengerx();
            });

            $("input[name=flight_classx]").change(function () {

                getPassengerx();
            });
            function getPassengerx() {
                var str = (parseInt($("#flight_adultx").val()) + parseInt($("#flight_childx").val()) + parseInt($("#flight_infantx").val())) + " Pax";
                var chk_cls = $('input[name=flight_classx]:checked').val();
                // alert(str);
                if (chk_cls == "1") {
                    str += ", First";
                }
                else if (chk_cls == "2") {
                    str += ", Business";
                }
                else if (chk_cls == "3") {
                    str += ", Premimum Economy";
                }
                else {
                    str += ", Economy";
                }
                $("#txtPassengers").val(str);
            }


        });
    </script>
