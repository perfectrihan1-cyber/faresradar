                $("#cc_cvv").attr('maxlength', '4');
            }
            else {
                $("#cc_cvv").attr('maxlength', '3');
            }
        }

        function SetCardType() {

            var cardType = $.payment.cardType($('.cc_number').val());
            $("#cc_card_type").val(cardType);
            $('#cardType').val(cardType).change();

        }

    </script>

