                                System.Data.DataTable dtx2 = new System.Data.DataTable();
                                dtx2 = SqlData.Data.SqlHelperData.ExecuteDataset(SqlData.Data.SqlHelperData.ConnectionString, System.Data.CommandType.Text, sql2).Tables[0];
