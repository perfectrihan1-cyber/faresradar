                var pass_flag = true;
                $(".chk_pass").each(function(i){
                    if($(this).val().trim(' ') == "")
                    {
                        alert("Please enter your passenger detail.");
                        $(this).focus();
                        pass_flag = false;
                        return false;
                    }
                });
            });

            $("#pass_addr_back").click(function () {
                $("#addr_detail").slideUp(function(){ $("#cont_detail").slideDown(); });
