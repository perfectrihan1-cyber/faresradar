@model Viman.Models.FlightsBooking
@using Viman.Models
@{
    ViewBag.Title = "Booking";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.WebsiteURL = Common.WebsiteURL;
    ViewBag.StaticURL = Common.StaticURL;
    ViewBag.Currency = Common.Currency;
    FlightsSearch flightSearch = ViewBag.flightSearch;
    Flights flights = ViewBag.flights;

    int mm = 0, nn = 0, pass = 0;


    <link href="@(ViewBag.StaticURL + "Content/bootstrap.css")" rel="stylesheet" />
    <link href="@(ViewBag.StaticURL + "Content//mainstyle.css")" rel="stylesheet" />
}

<div class="clearfix"></div>
<section class="result-page">
    <div class="container">
        <div class="fare-1">@(flights.Outbound[0].FromAirport.Code) <i class="fa fa-arrows-h"></i> @(flights.Outbound[flights.Outbound.Count - 1].ToAirport.Code) </div>
        <div class="fare-2">08/17/2022 - 08/31/2022</div>
        <div class="fare-3">
            @((flightSearch.FlightWay == FlightWay.OneWay) ? "Oneway" : "Return") Flight
            <span>@(flightSearch.Adult + flightSearch.Child + flightSearch.Infant) Tickets : @(flightSearch.Adult + " Adult") @((flightSearch.Child > 0) ? ", " + flightSearch.Child + " Child" : "") @((flightSearch.Infant > 0) ? ", " + flightSearch.Infant + " Infant" : "")</span>
        </div>
        <div class="clearfix"></div>
    </div>
</section>

<div class="container-fluid">
    <div class="container">
        <div class="passanger-main">
            <div class="left-passanger">
                <div class="phone-all">
                    <p>
                        <strong><i class="fa fa-lock" style=" color: #FF6600;"></i>  Review Your Trip Details &amp; Book</strong> This is the last step - only a couple more minutes and you’re done!
                    </p>
                </div>
            </div>
            <div class="right-passanger">
                <span>Call Now <a href="tel:+1-646-9339-578"><font> <i class="fa fa-phone"></i> 1-646-9339-578</font></a></span>
            </div>
        </div>
        <div class="passenger-contect">
