                <div class="clearfix"></div>
                <div class="passenge-left-main">
                    <div class="left-result-1">
                        <span class="bnd_det_heading">
                            <img src="~/Content/Images/icon_out_bound.png">  OUTBOUND FLIGHT &nbsp;&nbsp;&nbsp;&nbsp;
                            @(flights.Outbound[0].FromAirport.Code) (@(flights.Outbound[0].FromAirport.CityName)) → @(flights.Outbound[flights.Outbound.Count - 1].ToAirport.Code) (@(flights.Outbound[flights.Outbound.Count - 1].ToAirport.CityName))</h4>

                            <span style="float:right;">Time : @Math.Floor(decimal.Parse(flights.Outbound[0].TotalTime) / 60): @(Math.Floor(decimal.Parse(flights.Outbound[0].TotalTime) % 60)) hrs</span>
                        </span>
                        @foreach (FlightsSegment outboundArr in flights.Outbound)
                        {
                            double eftOutbound = double.Parse(flights.Outbound[mm].TotalTime); //double.Parse(Common.GetTime(flights.Outbound[mm].ArrivalDate, flights.Outbound[mm].DepartureDate) + "");
                            mm++;

                            <div class="diplay-rsr-1">
                                <img src="@(ViewBag.StaticURL + "Content/airline/fit/" + outboundArr.Airline.Code + ".gif")" />
                            </div>
                            <div class="diplay-rsr-2">
                                <p>@(outboundArr.DepartureDate.ToString("HH:mm")), </p>
                                <span>@(outboundArr.DepartureDate.ToString("dd MMM yyyy"))</span>
                            </div>
                            <div class="diplay-rsr-3">
                                <div class="depart-1">@(outboundArr.FromAirport.Code) <span>@(outboundArr.FromAirport.Name) / @(outboundArr.FromTerminal)</span></div>
                                <div class="depart-2"> </div> @*@(Math.Floor(eftOutbound / 60))h @(Math.Floor(eftOutbound % 60))m*@
                                <div class="depart-3"> @(outboundArr.ToAirport.Code) <font>@(outboundArr.ToAirport.Name) /@(outboundArr.ToTerminal) </font> </div>
                            </div>
                            <div class="diplay-rsr-4">
                                <p>@(outboundArr.ArrivalDate.ToString("HH:mm"))</p>
                                <span>@(outboundArr.ArrivalDate.ToString("dd MMM yyyy"))</span>
                            </div>
                            <div class="diplay-rsr-5">
                                <p>@flights.Outbound[0].CabinClass</p>
                            </div>
                            <div class="clearfix"></div>
                            <span class="bag_weight">
                                @(outboundArr.Airline.Code) / @(outboundArr.FlightNo)
                            </span>
                            <div class="clearfix"></div>

                            @*@if (mm != 1)
                                {
                                    double stop_time = double.Parse(Common.GetTime(flights.Outbound[mm - 1].DepartureDate, flights.Outbound[mm - 2].ArrivalDate) + "");
