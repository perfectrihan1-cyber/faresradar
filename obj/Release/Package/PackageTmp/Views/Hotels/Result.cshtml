                                <div class="hol_loc">
                                    <label class="loc_hot_chkbox" for="nearby_@(nearBy.Replace(" ", "").Replace("/", "").Replace("'", "").Replace("(", "").Replace(")", ""))">
                                        <input type="checkbox" class="airline_flt" name="filterNearPlace" id="nearby_@(nearBy.Replace(" ", "").Replace("/", "").Replace("'", "").Replace("(", "").Replace(")", ""))" ng-model="NearBy@(nearBy.Replace(" ", "").Replace("/", "").Replace("'", "").Replace("(", "").Replace(")", ""))" value="@(nearBy)">
                                        <span class="checkmark"></span>
                                        <bdo>@(nearBy)</bdo>
                                    </label>
                                </div>
                            }
                        }
                    </div>
                    <div class="hol_pannel clearfix">
                        <div class="slc_flrt_all">
