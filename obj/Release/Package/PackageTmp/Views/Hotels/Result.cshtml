                        <input type="text" class="hol_min_max_price" ng-model="lowestPrice.maxPrice" name="max_price" id="max_price" value="@(Model.MaxPrice)" style="display:none;">
                        <div id="slider-range" class="scal_price"></div>
                    </div>

                    <div class="star_pannel">
                        <div class="slc_flrt_all">
