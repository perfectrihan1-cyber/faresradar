                                <label class="loc_hot_chkbox" for="boardtype_@(boardType.Replace(" ", "").Replace("/", "").Replace("'", "").Replace("(", "").Replace(")", ""))">
                                    <input type="checkbox" class="airline_flt" name="filterBoardType" id="boardtype_@(boardType.Replace(" ", "").Replace("/", "").Replace("'", "").Replace("(", "").Replace(")", ""))" ng-model="BoardType@(boardType.Replace(" ","").Replace("/", "").Replace("'", "").Replace("(", "").Replace(")", ""))" value="@(boardType)">
                                    <span class="checkmark"></span>
                                    <bdo>@(boardType)</bdo>
                                </label>
                            </div>
                        }
