                            <bdo>{{hotelOrderByText}} <i class="fa fa-sort"></i> </bdo>
                        </h2>
                        <div class="hol_srt_by">
                            <ul>
                                <li><a href="javascript:void(0);" ng-click="hotelOrderBy('LowestPrice', false)">Price (low to high)</a></li>
                                <li><a href="javascript:void(0);" ng-click="hotelOrderBy('LowestPrice', true)">Price (high to low)</a></li>
                                <li><a href="javascript:void(0);" ng-click="hotelOrderBy('HotelName', false)">Hotel Name (A-Z)</a></li>
                                <li><a href="javascript:void(0);" ng-click="hotelOrderBy('HotelName', true)">Hotel Name (Z-A)</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="hol_srch_pgn">
                        <select name="noPerPage" id="noPerPage" ng-init="noPerPage='50'" ng-model="noPerPage" class="form-control pull-left" style="width:75px;">
