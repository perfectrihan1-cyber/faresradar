                        </div>
                        <div class="res_hot_cont_box">
                            <h4>{{hotels.HotelName}}</h4>
                            <div class="hot_srch_star_box">
                                <img src="@(ViewBag.StaticURL + "Content/images/hotel_star.svg")" ng-if="hotels.StarRating >= 1" />
                                <img src="@(ViewBag.StaticURL + "Content/images/hotel_star.svg")" ng-if="hotels.StarRating >= 2" />
                                <img src="@(ViewBag.StaticURL + "Content/images/hotel_star.svg")" ng-if="hotels.StarRating >= 3" />
                                <img src="@(ViewBag.StaticURL + "Content/images/hotel_star.svg")" ng-if="hotels.StarRating >= 4" />
                                <img src="@(ViewBag.StaticURL + "Content/images/hotel_star.svg")" ng-if="hotels.StarRating >= 5" />
                            </div>
                            <p class="res_hol_loc">
                                <i class="fa fa-map-marker"></i>
                                <b>{{hotels.Address}}</b>
                            </p>
                            <p class="res_hol_desp">{{hotels.Description.substr(0,200) | htmlToPlaintext}}</p>
                        </div>
                        <div class="res_hot_prc_box">
                            <div class="btm_touch">
                                <div class="res_hot_prc_off">
                                    @*<p class="off">17% OFF</p>
                                        <p class="reg_prc">£211</p>*@
                                    <h4 class="main_prc"><bdo></bdo> @(ViewBag.Currency) {{hotels.PerNightPrice | number:2}}</h4>
                                    <p class="smal_txt">{{hotels.LowestPrice | number:2}} GBP total</p>
                                </div>
                                <div class="res_hot_vw_dl">
                                    <a href="@(ViewBag.StaticURL + "hotels/detail/?sess="){{hotels.HotelId}}" class="book_hotel_btn" data-id="{{hotels.HotelId}}">Book Now</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section scripts{
    <script type="text/javascript" src="@(ViewBag.StaticURL + "Content/js/angular/angular.min.js")"></script>
    <script type="text/javascript" src="@(ViewBag.StaticURL + "Content/js/powertip.js")"></script>
    <script type="text/javascript">
        var HotelApp = angular.module('HotelApp', ['angularUtils.directives.dirPagination'])
        HotelApp.controller('HotelController', ['$scope', '$filter', function ($scope, $filter) {
            $scope.hotelResult = @Html.Raw(Common.ConvertJson(Model));
            $scope.lowestPrice = { 'minPrice': @(Model.MinPrice), 'maxPrice': @(Model.MaxPrice) };
            $scope.order_item = 'LowestPrice';
            $scope.order_reverse = false;
            $scope.hotelOrderByText = "Price (low to high)";

            $scope.totalPerPage = ["20", "50", "100"];
            $scope.noPerPage = 50;
            $scope.currentPage = 1;
            $scope.currentPageStart = 1;
            $scope.currentPageEnd = $scope.noPerPage;
            $scope.TotalHotelResult = $scope.hotelResult.HotelsList.length;
            if ($scope.currentPageEnd > $scope.TotalHotelResult) {
                $scope.currentPageEnd = $scope.TotalHotelResult;
            }

            $("#slider-range").slider({
                range: true,
                min: @(Model.MinPrice),
                max: @(Model.MaxPrice),
                values: [ @(Model.MinPrice), @(Model.MaxPrice) ],
                slide: function(event, ui){
                    $("#hol_min_price").html("£" + ui.values[0]);
                    $("#hol_max_price").html("£" + ui.values[1]);
                    $("#min_price").val(ui.values[0]);
                    $("#max_price").val(ui.values[1]);
                },
                stop: function( event, ui ) {
                    $("#priceEvent").trigger('click');
                }
            });

            $scope.priceChanged = function () {
                $filter('priceFilter')(1);
            };

            $scope.clearFilter = function () {
                alert("hello");
                $scope.hotelName = '';

                $("#min_price").val($scope.lowestPrice.minPrice);
                $("#max_price").val($scope.lowestPrice.maxPrice);
                $("#hol_min_price").text("£" + $scope.lowestPrice.minPrice);
                $("#hol_max_price").text("£" + $scope.lowestPrice.maxPrice);
                alert("hello1");
                $('input[name="filterStar"]').attr('checked', false);
                $('input[name="filterBoardType"]').attr('checked', false);
                $('input[name="filterNearPlace"]').attr('checked', false);
                alert("hello2");
            };

            $scope.hotelOrderBy = function (orderItem, orderReverse) {
                $scope.order_item = orderItem;
                $scope.order_reverse = orderReverse;

                if (orderItem == "LowestPrice" && orderReverse)
                    $scope.hotelOrderByText = "Price Low to High";
                else if (orderItem == "LowestPrice" && !orderReverse)
                    $scope.hotelOrderByText = "Price High to Low";
                else if (orderItem == "HotelName" && orderReverse)
                    $scope.hotelOrderByText = "Hotel Name (Z-A)";
                else if (orderItem == "HotelName" && !orderReverse)
                    $scope.hotelOrderByText = "Hotel Name (A-Z)";
                else if (orderItem == "StarRating" && orderReverse)
                    $scope.hotelOrderByText = "Guest Rating (high to low)";
                else if (orderItem == "StarRating" && !orderReverse)
                    $scope.hotelOrderByText = "Guest Rating (low to high)";
                else if (orderItem == "NearByDistance" && orderReverse)
                    $scope.hotelOrderByText = "Distance (high to low)";
                else if (orderItem == "NearByDistance" && !orderReverse)
                    $scope.hotelOrderByText = "Distance (low to high)";
            };

            $scope.pageChanged = function (newPage) {
                $scope.currentPage = newPage;
                $scope.currentPageStart = ((newPage - 1) * $scope.noPerPage) + 1;
                $scope.currentPageEnd = newPage * $scope.noPerPage;
                if ($scope.currentPageEnd > $scope.TotalHotelResult) {
                    $scope.currentPageEnd = $scope.TotalHotelResult;
                }
            };
        }]);

        HotelApp.filter('htmlToPlaintext', function() {
            return function(text) {
                return  text ? String(text).replace(/<[^>]+>/gm, '') : '';
            };
        });

        HotelApp.filter('priceFilter', function () {
            return function (items, price) {
                var filtered = [];
                var minPrice = parseInt(($("#min_price").val()) ? $("#min_price").val() : @(Model.MinPrice));
                var maxPrice = parseInt(($("#max_price").val()) ? $("#max_price").val() : @(Model.MaxPrice));

                angular.forEach(items, function (item) {
                    if (item.PerNightPrice >= minPrice && item.PerNightPrice <= maxPrice) {
                        filtered.push(item);
                    }
                });

                return filtered;
            };
        });

        HotelApp.filter('starFilter', function () {
            return function (items, num) {
                var filtered = [];
                var curr_star = [];
                var curr_star_all = false; //$('input[name="filterStarAll"]').is(':checked');

                $('input[name="filterStar"]:checked').each(function () {
                    curr_star.push(this.value);
                });

                angular.forEach(items, function (item) {
                    if (curr_star.length == 0 || curr_star_all) {
                        filtered.push(item);
                    } else {
                        if ($.inArray(item.StarRating, curr_star) != -1) {
                            filtered.push(item);
                        }
                    }
                });

                return filtered;
            };
        });

        HotelApp.filter('nearPlaceFilter', function () {
            return function (items, num) {
                var filtered = [];
                var curr_place = [];
                var curr_place_all = $('input[name="filterNearPlaceAll"]').is(':checked');

                $('input[name="filterNearPlace"]:checked').each(function () {
                    curr_place.push(this.value);
                });

                angular.forEach(items, function (item) {
                    if (curr_place.length == 0 || curr_place_all) {
                        filtered.push(item);
                    } else {
                        if ($.inArray(item.NearByLocation, curr_place) != -1) {
                            filtered.push(item);
                        }
                    }
                });

                return filtered;
            };
        });

        HotelApp.filter('boardTypeFilter', function () {
            return function (items, num) {
                var filtered = [];
                var curr_board = [];
                var curr_board_all = false; //$('input[name="filterBoardTypeAll"]').is(':checked');

                $('input[name="filterBoardType"]:checked').each(function () {
                    curr_board.push(this.value);
                });

                angular.forEach(items, function (item) {
                    if (curr_board.length == 0 || curr_board_all) {
                        filtered.push(item);
                    } else {
                        var temp_board = item.OnBoardType.split(',');
                        angular.forEach(temp_board, function (tboard) {
                            if ($.inArray(tboard, curr_board) != -1) {
                                filtered.push(item);
                            }
                        });
                    }
                });

                return filtered;
            };
        });

        $(window).on("load", function(){
            $.ready.then(function(){
                $("#auto_load").hide();
                $("#data_load").show();
            });
        });

        $(function () {
            $("#hotel_submit").click(function () {
                if ($("#city_id").val().trim(' ') == "") {
                    alert("Please enter your location or city.");
                    $("#city_name").focus();
                    return false;
                }
                else if ($("#check_in_date").val().trim(' ') == "") {
                    alert("Please select your check in date.");
                    $("#check_in_date").focus();
                    return false;
                }
                else if ($("#check_out_date").val().trim(' ') == "") {
                    alert("Please select your check out date.");
                    $("#check_out_date").focus();
                    return false;
                }
                else {
                    var city_name = "&City=" + $("#city_id").val();
                    var checkInDate = "&CheckInDate=" + $("#check_in_date").val().split("-")[2] + "-" + $("#check_in_date").val().split("-")[1] + "-" + $("#check_in_date").val().split("-")[0];
                    var checkOutDate = "&CheckOutDate=" + $("#check_out_date").val().split("-")[2] + "-" + $("#check_out_date").val().split("-")[1] + "-" + $("#check_out_date").val().split("-")[0];
                    var nationality = "&Nationality=" + $("#nationality").val();
                    var room_txt = "", adult_txt = "", child_txt = "";
                    var room = parseInt($("#hotel_room").val());
                    room_txt += "&Room=" + room;
                    var adt_cnt = 0, chd_cnt = 0;
                    for (var i = 1; i <= room; i++)
                    {
                        adt_cnt += parseInt($("#adult_" + i).val());
                        chd_cnt += parseInt($("#child_" + i).val());

                        adult_txt += "," + $("#adult_" + i).val();
                        var child_sub_txt = "";
                        for(var j = 1; j <= parseInt($("#child_" + i).val()); j++)
                        {
                            child_sub_txt += "," + $("#child_" + i + "_" + j).val();
                        }
                        child_txt += "$" + child_sub_txt.substring(1);
                    }
                    room_txt += "&Adult=" + adult_txt.substring(1);
                    room_txt += "&Child=" + child_txt.substring(1);

                    var str = "@(ViewBag.WebsiteURL + "hotels/search?")SiteCode=VIMAN&SourceMedia=VIMAN" + city_name + checkInDate + checkOutDate + room_txt + nationality + "&Currency=GBP&IsAvilable=false";
                    //alert(str);
                    var monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                    $("#fp_city_name").html($("#city_name").val().split(",")[0]);
                    var dd_tp = $("#check_in_date").val().split("-");
                    $("#fp_checkin_date").html(dd_tp[0] + " " + monthNames[dd_tp[1] - 1] + ", " + dd_tp[2]);
                    var rd_tp = $("#check_out_date").val().split("-");
                    $("#fp_checkout_date").html(rd_tp[0] + " " + monthNames[rd_tp[1] - 1] + ", " + rd_tp[2]);
                    $("#fp_rooms").html($("#hotel_room").val() + " Room(s)");
                    $("#fp_guests").html(adt_cnt + " Adult, " + chd_cnt + " Child");
                    $("#hotel_popup").show();

                    window.location = str;
                }
            });

            var selectLocation = false;

            $('#city_name').autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/api/getcity",
                        dataType: "json",
                        data: {
                            pickUpLocation: request.term
                        },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    value: item.TravellandaCityId,
                                    label: (item.CityName + ", " + item.CountryName)
                                }
                            }));
                        }
                    })
                },
                open: function (event, ui) { selectLocation = true; },
                select: function (event, ui) {
                    $("#city_name").val(ui.item.label);
                    $("#city_id").val(ui.item.value);
                    selectLocation = false;
                    return false;
                },
                close: function (event, ui) {
                    selectLocation = false;
                },
                minLength: 3,
                autoFocus: true
            }).blur(function () {
                if (selectLocation) {
                    $("#city_name").val($('ul.ui-autocomplete li:first a').text());
                }
            }).focus(function () {
                $(this).autocomplete("search");
            });

            $("#check_in_date").datepicker({
                format: 'dd-mm-yyyy',
                startDate: '@DateTime.Now.AddDays(2).ToString("dd-MM-yyyy")',
                autoHide: true
            }).on('pick.datepicker', function (e) {
                var currdate = getStr(e.date.getDate()) + "-" + getStr((e.date.getMonth() + 1)) + "-" + e.date.getFullYear();
                $("#check_out_date").val(currdate);
                $("#check_out_date").datepicker('setDate', e.date);
                $("#check_out_date").datepicker('setStartDate', e.date);
                $("#check_out_date").focus();
            });
            $("#check_out_date").datepicker({
                format: 'dd-mm-yyyy',
                startDate: '@DateTime.Now.AddDays(7).ToString("dd-MM-yyyy")',
                autoHide: true
            });

            $("#prsn_add_hotel").click(function () {
                $("#prsn_hotel_popup").slideDown("slow");
            });
            $("#prsn_done_hotel").click(function () {
                $("#prsn_hotel_popup").slideUp("slow");
            });
            $('body').click(function () {
                $("#prsn_hotel_popup").slideUp("slow");
            });
            $('.prp_hotel_popup').click(function (e) {
                e.stopPropagation();
            });

            $(".inc_der").click(function () {
                var fld = $(this).attr("data-field");
                var fld_opt = $(this).attr("data-opt");
                var room = parseInt($("#hotel_room").val());

                if (fld == "room") {
                    if (fld_opt == "+") {
                        if (room < 6) {
                            room = room + 1;
                            $("#hotel_room").val(room);
                        }
                    }
                    else if (fld_opt == "-") {
                        if (room > 1) {
                            room = room - 1;
                            $("#hotel_room").val(room);
                        }
                    }
                }

                var fld_val = room + " Room(s)";
                var total_adt = 0, total_chd = 0;
                $(".adt_chd_cnt").hide();
                for(var i=1; i<=room;i++)
                {
                    $("#adt_chd_" + i).show();
                    var adt = parseInt($("#adult_"+i).val());
                    var chd = parseInt($("#child_"+i).val());
                    if (fld == "adult_" + i) {
                        if (fld_opt == "+") {
                            if ((adt + chd) < 5) {
                                adt = adt + 1;
                                $("#adult_"+i).val(adt);
                            }
                        }
                        else if (fld_opt == "-") {
                            if (adt > 1) {
                                adt = adt - 1;
                                $("#adult_"+i).val(adt);
                            }
                        }
                    }
                    else if (fld == "child_" + i) {
                        if (fld_opt == "+") {
                            if ((adt + chd) < 5) {
                                chd = chd + 1;
                                $("#child_" + i).val(chd);
                            }
                        }
                        else if (fld_opt == "-") {
                            if (chd > 0) {
                                chd = chd - 1;
                                $("#child_" + i).val(chd);
                            }
                        }

                        if (chd == 0) {
                            $("#hotel_chd_age_" + i).hide();
                        }
                        else {
                            $("#hotel_chd_age_" + i).show();
                            $(".hotel_chd_age_fld_" + i).hide();
                            for (var j = 1; j <= chd; j++) {
                                $("#child_" + i + "_" + j).show();
                            }
                        }
                    }

                    total_adt += adt;
                    total_chd += chd;
                }

                fld_val = fld_val + ", " + total_adt + " Adults(s), " + total_chd + " Child(s)";
                $("#txt_hotel_pax").val(fld_val);
            });




            $("#btn_serch_show, #btn_serch_showMb").click(function () {
                $(".hol_outer_search_box").slideToggle("slow");
            });
            $(".res_hot_mai_hd").click(function () {
                $(".hol_srt_by").slideToggle("slow");
            });
            $('.north').powerTip({ placement: 'n' });

            /*if($(document).width() > 990){
                if ($('#sticky').length) {
                    var el = $('#sticky');
                    var stickyTop = $('#sticky').offset().top;
                    var stickyHeight = $('#sticky').height();

                    $(window).scroll(function () {
                        var limit = $('#footer').offset().top - stickyHeight - 13;
                        var windowTop = $(window).scrollTop();
                        if (stickyTop < windowTop) {
                            el.addClass("sticky_pos")
                        } else {
                            el.removeClass("sticky_pos");
                        }

                        if (limit < windowTop) {
                            var diff = limit - windowTop;
                            el.css({
                                top: diff
                            });
                        }
                    });
                }
            }*/
        });
        $("#btn_serch_show, #btn_serch_showMb").click(function () {
            $(".hol_outer_search_box").slideToggle("slow");
        });

        $("#btn_serch_show").click(function () {
            $(".res_hol_ind_main_searbox").slideToggle("slow");
        });
    </script>
}
