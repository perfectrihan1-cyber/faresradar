                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <dir-pagination-controls class="pull-right" max-size="7" direction-links="true" boundary-links="true" on-page-change="pageChanged(newPageNumber)"> </dir-pagination-controls>
                    </div>

                    <div class="res_hot_main_box clearfix" dir-paginate="hotels in hotelResult.HotelsList | starFilter | priceFilter | nearPlaceFilter | boardTypeFilter | filter : {HotelName : hotelName} | orderBy : order_item : order_reverse | itemsPerPage : noPerPage" ng-init="hotelIndex = $index" data-loop="{{hotelIndex}}">
