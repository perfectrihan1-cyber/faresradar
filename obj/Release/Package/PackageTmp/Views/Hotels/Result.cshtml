                        <input type="text" placeholder="Hotel Name" ng-model="hotelName" name="hotel_name" id="hotel_name" />
                        <i class="fa fa-search"></i>
                    </div>
                    <div class="hol_price_panel">
                        <h4> <i class="fa fa-gbp"></i> Price</h4>
