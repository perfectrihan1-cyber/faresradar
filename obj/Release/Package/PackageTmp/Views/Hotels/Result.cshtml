@model Viman.Models.HotelsResult
@using Viman.Models
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Result";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.WebsiteURL = Common.WebsiteURL;
    ViewBag.StaticURL = Common.StaticURL;
    ViewBag.Currency = Common.Currency;

    int noOfNight = int.Parse(Common.GetDateDiffDay(Model.HotelsSearch.CheckOut, Model.HotelsSearch.CheckIn));
}
<link type="text/css" rel="stylesheet" href="@(ViewBag.StaticURL + "Content/css/powertip.css")" />
<div class="background_top"></div>

<div class="container">
    <div class="row">
        <div class="col-xs-12">
            <div class="hol_top_summry">
                <div class="hol_modify_button">
                    <a href="javascript:void(0);" id="btn_serch_show">
                        MODIFY
                        <i class="fa fa-angle-down"></i>
                    </a>
                </div>

                <div class="hol_top_sum_lft clearfix">
                    <div class="hol_top_mb_desti">
                        <span>@(Model.HotelsSearch.Location.CityName + ", " + Model.HotelsSearch.Location.CountryName)</span>
                    </div>
                    <ul class="hol_dat_travlr">
                        <li><span>@(Model.HotelsSearch.CheckIn.ToString("dd MMM"))</span></li>
                        <li><span>@(Model.HotelsSearch.CheckOut.ToString("dd MMM"))</span></li>
                        <li><span>@(Model.HotelsSearch.Rooms) Room, @(ViewBag.AdultsCnt + ViewBag.ChildrenCnt) Guest</span></li>
                    </ul>
                </div>

                <ul class="hol_main_li_summry clearfix">
                    <li>
                        <div class="hol_top_smy_des">
                            <span>@(Model.HotelsSearch.Location.CityName + ", " + Model.HotelsSearch.Location.CountryName)</span>
                        </div>
                    </li>
                    <li>
                        <div class="hol_top_smy_date">
                            <span>@(Model.HotelsSearch.CheckIn.ToString("ddd dd MMM, yyyy")) &nbsp; to&nbsp; <bdo>@(Model.HotelsSearch.CheckOut.ToString("ddd dd MMM, yyyy"))</bdo> (@(noOfNight) Nights)</span>
                        </div>
                    </li>
                    <li>
                        <div class="hol_prsn_smry_icon">
                            <span>@(Model.HotelsSearch.Rooms) Room(s), @(ViewBag.AdultsCnt + ViewBag.ChildrenCnt) Guest(s)</span>
                        </div>
                    </li>
                </ul>
                <div class="res_hol_ind_main_searbox">
                    <div>
                        <div class="hol_ind_srch_subBox hol_inlg_dvc"> 
                            <i class="fa fa-map-marker"></i>
                            <input type="hidden" value="@(Model.HotelsSearch.Location.TravellandaCityId)" id="city_id" name="city_id" />
                            <input type="text" placeholder="Location/City" name="city_name" id="city_name" value="@(ViewBag.cityName)" class="hol_ind_inputBox">
                        </div>

                        <div class="hol_ind_srch_subBox hol_inlg_date">
                            <i class="fa fa-calendar" for="from_date"></i>
                            <input type="text" placeholder="Check-in Date" class="hol_ind_inputBox" value="@((ViewBag.checkInDate != "") ? ViewBag.checkInDate : DateTime.Now.AddDays(2).ToString("dd-MM-yyyy"))" id="check_in_date" name="check_in_date" readonly="true">
                        </div>
                        <div class="hol_ind_srch_subBox hol_inlg_datergt">
                            <i class="fa fa-calendar" for="to_date"></i>
                            <input type="text" placeholder="Check-Out Date" class="hol_ind_inputBox" value="@((ViewBag.checkOutDate != "") ? ViewBag.checkOutDate : DateTime.Now.AddDays(7).ToString("dd-MM-yyyy"))" name="check_out_date" id="check_out_date" readonly="true">
                        </div>
                        <div class="hol_ind_srch_subBox hol_inlg_date prp_hotel_popup">
                            <div id="prsn_add_hotel">
                                <i class="fa fa-angle-down"></i>
                                <input type="text" name="txt_hotel_pax" id="txt_hotel_pax" placeholder="@((Model.HotelsSearch.Rooms.Equals(""))?"1":Model.HotelsSearch.Rooms) Room(s), @(ViewBag.AdultsCnt) Adult(s), @(ViewBag.ChildrenCnt) Child(s)" style="cursor:pointer;" readonly class="hol_ind_inputBox">
                            </div>
                            <div class="hol_person_dropdown" id="prsn_hotel_popup">
                                <ul class="slect_room">
                                    <li>
                                        <label>Room</label>
                                        <div class="count_persn">
                                            <a href="javascript:void(0);"><em data-field="room" data-opt="-" class="fa fa-minus inc_der"></em></a>
                                            <input type="text" value="@((Model.HotelsSearch.Rooms.Equals(""))?"1":Model.HotelsSearch.Rooms)" name="hotel_room" id="hotel_room" readonly class="inpt_cout_persn">
                                            <a href="javascript:void(0);"><em data-field="room" data-opt="+" class="fa fa-plus inc_der"></em></a>
                                        </div>
                                    </li>
                                </ul>
                                @for (int j = 1; j <= 6; j++)
                                {
                                    <div class="hotel_adult_count" id="adt_chd_@(j)" style="display:@((j == 1 || j <= int.Parse(Model.HotelsSearch.Rooms)) ? "block" : "none");">
                                        <ul>
                                            <li>
                                                <label>Adult </label>
                                                <div class="count_persn">
                                                    <a href="javascript:void(0);"><em data-field="adult_@(j)" data-opt="-" class="fa fa-minus inc_der"></em></a>
                                                    <input type="text" value="@((Model.HotelsSearch.Adults.Length >= j)?Model.HotelsSearch.Adults[j-1]:"1")" name="adult_@(j)" id="adult_@(j)" readonly class="inpt_cout_persn">
                                                    <a href="javascript:void(0);"><em data-field="adult_@(j)" data-opt="+" class="fa fa-plus inc_der"></em></a>
                                                </div>
                                            </li>
                                            <li>
                                                <label>Child </label>
                                                <div class="count_persn">
                                                    <a href="javascript:void(0);"><em data-field="child_@(j)" data-opt="-" class="fa fa-minus inc_der"></em></a>
                                                    <input type="text" value="@((Model.HotelsSearch.Childs.GetLength(0) >= j)?Model.HotelsSearch.Childs[j-1].Length+"":"0")" name="child_@(j)" id="child_@(j)" readonly class="inpt_cout_persn">
                                                    <a href="javascript:void(0);"><em data-field="child_@(j)" data-opt="+" class="fa fa-plus inc_der"></em></a>
                                                </div>
                                            </li>
                                        </ul>
                                        <div class="hotel_chd_age" id="hotel_chd_age_@(j)" style="display:@((Model.HotelsSearch.Childs.GetLength(0) >= j)?"block":"none");">
                                            <label class="chil_label">Child Age:</label>
                                            @for (int k = 1; k <= 4; k++)
                                            {
                                                <span id="parnt_chl_age">
                                                    <span id="parnt_child">
                                                        <select name="child_@(j)_@(k)" id="child_@(j)_@(k)" class="hotel_chd_age_fld_@(j)" style="display:@((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j-1].Length >= k)? "inline-block" : "none");">
                                                            <option value="">--</option>
                                                            <option @((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j - 1].Length >= k && Model.HotelsSearch.Childs[j - 1][k - 1].Equals("1")) ? "selected" : "") value="1">01</option>
                                                            <option @((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j - 1].Length >= k && Model.HotelsSearch.Childs[j - 1][k - 1].Equals("2")) ? "selected" : "") value="2">02</option>
                                                            <option @((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j - 1].Length >= k && Model.HotelsSearch.Childs[j - 1][k - 1].Equals("3")) ? "selected" : "") value="3">03</option>
                                                            <option @((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j - 1].Length >= k && Model.HotelsSearch.Childs[j - 1][k - 1].Equals("4")) ? "selected" : "") value="4">04</option>
                                                            <option @((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j - 1].Length >= k && Model.HotelsSearch.Childs[j - 1][k - 1].Equals("5")) ? "selected" : "") value="5">05</option>
                                                            <option @((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j - 1].Length >= k && Model.HotelsSearch.Childs[j - 1][k - 1].Equals("6")) ? "selected" : "") value="6">06</option>
                                                            <option @((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j - 1].Length >= k && Model.HotelsSearch.Childs[j - 1][k - 1].Equals("7")) ? "selected" : "") value="7">07</option>
                                                            <option @((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j - 1].Length >= k && Model.HotelsSearch.Childs[j - 1][k - 1].Equals("8")) ? "selected" : "") value="8">08</option>
                                                            <option @((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j - 1].Length >= k && Model.HotelsSearch.Childs[j - 1][k - 1].Equals("9")) ? "selected" : "") value="9">09</option>
                                                            <option @((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j - 1].Length >= k && Model.HotelsSearch.Childs[j - 1][k - 1].Equals("10")) ? "selected" : "") value="10">10</option>
                                                            <option @((Model.HotelsSearch.Childs.GetLength(0) >= j && Model.HotelsSearch.Childs[j - 1].Length >= k && Model.HotelsSearch.Childs[j - 1][k - 1].Equals("11")) ? "selected" : "") value="11">11</option>
                                                        </select>
                                                    </span>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                                <div class="hol_clss_done" id="hol_ind_done">
                                    <a href="javascript:void(0);" id="prsn_done_hotel">Done</a>
                                </div>
                            </div>
                        </div>
                        <div class="hol_ind_srch_subBox hol_inlg_datergt">
                            <select class="hol_ind_inputBox" name="nationality" id="nationality">
                                <option value="">Select Country</option>
                                @foreach (Country country in ViewBag.countryList)
                                {
                                    <option @((country.Code.Equals("GB")) ? "selected" : "") value="@(country.Code)">@(country.Name)</option>
                                }
                            </select>
                        </div>
                        <input href="javascript:void(0);" type="submit" name="hotel_submit" id="hotel_submit" class="hol_ind_sbm_btn">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="blue_pop" id="hotel_popup">
    <div class="blue_clock">
        <div class="spinnerClock">
            <div class="spinnerClock__clock"></div>
            <div class="spinnerClock__minHand"></div>
            <div class="spinnerClock__secHand"></div>
            <div class="spinnerClock__secondHand"></div>
        </div>

        <h3>Looking for your hotels!</h3>
        <p>Please Wait... it will take a couple of seconds</p>
    </div>
</div>
<div class="gap">
</div>
@if (ViewBag.msg.Equals("noresult") || Model.HotelsList == null)
{
    ViewBag.msg = "noresult";
    <div class="row">
        <div class="col-md-12">
            <div class="no_result">
                <i class="fa fa-frown-o"></i>
                <p>No results found for your selection. Click <b style="color:#f6921d;">MODIFY</b> to change your search.</p>
            </div>
        </div>
    </div>
}
