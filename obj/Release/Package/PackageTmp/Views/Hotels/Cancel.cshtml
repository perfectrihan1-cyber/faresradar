@using Viman.Models
@{
    ViewBag.Title = "Cancel";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.StaticURL = Common.StaticURL;
}

<div class="background_top"></div>

<div class="container">
    <div class="gap_small">&nbsp;</div>
    <div class="row">
        <div class="col-xs-12">
            <div class="hol_can_check">
                <i class="fa fa-times-circle"></i>
                <h2>@(Model.BookerDetail.FirstName), your payment was Abort!</h2>
                <h3>Booking details has been send to @(Model.BookerDetail.Email)</h3>
            </div>
            <div class="hol_can_list_order clearfix">
                <div class="hol_can_flt_dtl">
                    <div class="hol_can_pss_dtl">
                        <h3>
                            <i class="fa fa-bed"></i>
                            @(Model.Hotels.HotelName)
                        </h3>
                        <p>
                            @for (int j = 1; j <= Math.Ceiling(float.Parse(Model.Hotels.StarRating)); j++)
                            {
                                <i class="fa fa-star"></i>
                            }
                        </p>
                    </div>
                    <div class="hol_can_addr clearfix">
                        <h4><b>Address:</b>@(Model.Hotels.Address)</h4>
                        <span><b>Check in:</b> @(Model.HotelsSearch.CheckIn.ToString("dddd dd MMMM, yyyy"))</span>
                        <span><b>Check Out:</b> @(Model.HotelsSearch.CheckOut.ToString("dddd dd MMMM, yyyy"))</span>
                        <span><b>Rooms:</b> @(Common.GetDateDiffDay(Model.HotelsSearch.CheckOut, Model.HotelsSearch.CheckIn)) Night(s), @(Model.HotelsSearch.Rooms) Room(s)</span>
                        <span><b>Guests:</b> @(ViewBag.AdultsCnt) Adults(s), @(ViewBag.ChildrenCnt) Children(s)</span>
                    </div>

                    <div class="hol_can_total clearfix">
                        <span>Total Amount</span>
                        <strong>@(ViewBag.Currency) @(Model.Hotels.LowestPrice)</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="gap"></div>
