@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $("#hotel_submit").click(function () {
                if ($("#city_id").val().trim(' ') == "") {
                    alert("Please enter your location or city.");
                    $("#city_name").focus();
                    return false;
                }
                else if ($("#check_in_date").val().trim(' ') == "") {
                    alert("Please select your check in date.");
                    $("#check_in_date").focus();
                    return false;
                }
                else if ($("#check_out_date").val().trim(' ') == "") {
                    alert("Please select your check out date.");
                    $("#check_out_date").focus();
                    return false;
                }
                else {
                    var city_name = "&City=" + $("#city_id").val();
                    var checkInDate = "&CheckInDate=" + $("#check_in_date").val().split("-")[2] + "-" + $("#check_in_date").val().split("-")[1] + "-" + $("#check_in_date").val().split("-")[0];
                    var checkOutDate = "&CheckOutDate=" + $("#check_out_date").val().split("-")[2] + "-" + $("#check_out_date").val().split("-")[1] + "-" + $("#check_out_date").val().split("-")[0];
                    var nationality = "&Nationality=" + $("#nationality").val();
                    var room_txt = "", adult_txt = "", child_txt = "";
                    var room = parseInt($("#hotel_room").val());
                    room_txt += "&Room=" + room;
                    var adt_cnt = 0, chd_cnt = 0;
                    for (var i = 1; i <= room; i++) {
                        adt_cnt += parseInt($("#adult_" + i).val());
                        chd_cnt += parseInt($("#child_" + i).val());

                        adult_txt += "," + $("#adult_" + i).val();
                        var child_sub_txt = "";
                        for (var j = 1; j <= parseInt($("#child_" + i).val()) ; j++) {
                            child_sub_txt += "," + $("#child_" + i + "_" + j).val();
                        }
                        child_txt += "$" + child_sub_txt.substring(1);
                    }
                    room_txt += "&Adult=" + adult_txt.substring(1);
                    room_txt += "&Child=" + child_txt.substring(1);

                    var str = "@(ViewBag.WebsiteURL + "hotels/search?")SiteCode=VIMAN&SourceMedia=VIMAN" + city_name + checkInDate + checkOutDate + room_txt + nationality + "&Currency=GBP&IsAvilable=false";
                    //alert(str);
                    var monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                    $("#fp_city_name").html($("#city_name").val().split(",")[0]);
                    var dd_tp = $("#check_in_date").val().split("-");
                    $("#fp_checkin_date").html(dd_tp[0] + " " + monthNames[dd_tp[1] - 1] + ", " + dd_tp[2]);
                    var rd_tp = $("#check_out_date").val().split("-");
                    $("#fp_checkout_date").html(rd_tp[0] + " " + monthNames[rd_tp[1] - 1] + ", " + rd_tp[2]);
                    $("#fp_rooms").html($("#hotel_room").val() + " Room(s)");
                    $("#fp_guests").html(adt_cnt + " Adult, " + chd_cnt + " Child");

                    $("#hotel_popup").show();
                    window.location = str;
                }
            });

            var selectLocation = false;

            $('#city_name').autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/api/getcity",
                        dataType: "json",
                        data: {
                            pickUpLocation: request.term
                        },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    value: item.TravellandaCityId,
                                    label: (item.CityName + ", " + item.CountryName)
                                }
                            }));
                        }
                    })
                },
                open: function (event, ui) { selectLocation = false; },
                select: function (event, ui) {
                    $("#city_name").val(ui.item.label);
                    $("#city_id").val(ui.item.value);
                    selectLocation = false;
                    return false;
                },
                close: function (event, ui) {
                    selectLocation = false;
                },
                minLength: 3,
                autoFocus: true
            }).blur(function () {
                if (selectLocation) {
                    $("#city_name").val($('ul.ui-autocomplete li:first a').text());
                }
            }).focus(function () {
                $(this).autocomplete("search");
            });

            $("#check_in_date").datepicker({
                format: 'dd-mm-yyyy',
                startDate: '@DateTime.Now.AddDays(2).ToString("dd-MM-yyyy")',
                autoHide: true
            }).on('pick.datepicker', function (e) {
                var currdate = getStr(e.date.getDate()) + "-" + getStr((e.date.getMonth() + 1)) + "-" + e.date.getFullYear();
                $("#check_out_date").val(currdate);
                $("#check_out_date").datepicker('setDate', e.date);
                $("#check_out_date").datepicker('setStartDate', e.date);
                $("#check_out_date").focus();
            });
            $("#check_out_date").datepicker({
                format: 'dd-mm-yyyy',
                startDate: '@DateTime.Now.AddDays(7).ToString("dd-MM-yyyy")',
                autoHide: true
            });

            $("#prsn_add_hotel").click(function () {
                $("#prsn_hotel_popup").slideDown("slow");
            });
            $("#prsn_done_hotel").click(function () {
                $("#prsn_hotel_popup").slideUp("slow");
            });
            $('body').click(function () {
                $("#prsn_hotel_popup").slideUp("slow");
            });
            $('.prp_hotel_popup').click(function (e) {
                e.stopPropagation();
            });

            $(".inc_der").click(function () {
                var fld = $(this).attr("data-field");
                var fld_opt = $(this).attr("data-opt");
                var room = parseInt($("#hotel_room").val());

                if (fld == "room") {
                    if (fld_opt == "+") {
                        if (room < 6) {
                            room = room + 1;
                            $("#hotel_room").val(room);
                        }
                    }
                    else if (fld_opt == "-") {
                        if (room > 1) {
                            room = room - 1;
                            $("#hotel_room").val(room);
                        }
                    }
                }

                var fld_val = room + " Room(s)";
                var total_adt = 0, total_chd = 0;
                $(".adt_chd_cnt").hide();
                for (var i = 1; i <= room; i++) {
                    $("#adt_chd_" + i).show();
                    var adt = parseInt($("#adult_" + i).val());
                    var chd = parseInt($("#child_" + i).val());
                    if (fld == "adult_" + i) {
                        if (fld_opt == "+") {
                            if ((adt + chd) < 5) {
                                adt = adt + 1;
                                $("#adult_" + i).val(adt);
                            }
                        }
                        else if (fld_opt == "-") {
                            if (adt > 1) {
                                adt = adt - 1;
                                $("#adult_" + i).val(adt);
                            }
                        }
                    }
                    else if (fld == "child_" + i) {
                        if (fld_opt == "+") {
                            if ((adt + chd) < 5) {
                                chd = chd + 1;
                                $("#child_" + i).val(chd);
                            }
                        }
                        else if (fld_opt == "-") {
                            if (chd > 0) {
                                chd = chd - 1;
                                $("#child_" + i).val(chd);
                            }
                        }

                        if (chd == 0) {
                            $("#hotel_chd_age_" + i).hide();
                        }
                        else {
                            $("#hotel_chd_age_" + i).show();
                            $(".hotel_chd_age_fld_" + i).hide();
                            for (var j = 1; j <= chd; j++) {
                                $("#child_" + i + "_" + j).show();
                            }
                        }
                    }

                    total_adt += adt;
                    total_chd += chd;
                }

                fld_val = fld_val + ", " + total_adt + " Adults(s), " + total_chd + " Child(s)";
                $("#txt_hotel_pax").val(fld_val);
            });
        });
    </script>
}