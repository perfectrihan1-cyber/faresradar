@using Viman.Models
@{
    ViewBag.Title = "Hotels";
    ViewBag.PageName = "hotel";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Find Your Ideal Cheap Hotel | Book Budget Hotels | Book Cheap Hotels";
    ViewBag.MetaContent = "Book online cheap and best hotels from viman.co.uk. Compare and book budget hotels, resorts and luxurious hotels at low prices. Book best deals hotels online and avail huge discounts.";
    ViewBag.StaticURL = Common.StaticURL;
    ViewBag.WebsiteURL = Common.WebsiteURL;
}

<div class="background_top"></div>
<div class="hol_back_img_main">
    <div class="ind_sear_outbox">
        <div class="container">
            <div class="col-xs-12">
                <div class="hol_ind_srch_head">
                    <h3>Book Your Hotels</h3>
                </div>
                <div class="hol_ind_main_searbox">
                    <div>
                        <div class="hol_ind_srch_subBox hol_inlg_dvc">
                            <i class="fa fa-map-marker"></i>
                            <input type="hidden" value="@(ViewBag.cityId)" id="city_id" name="city_id" />
                            <input type="text" placeholder="Location/City" name="city_name" id="city_name" class="hol_ind_inputBox" value="@(ViewBag.cityName)" />
                        </div>

                        <div class="hol_ind_srch_subBox hol_inlg_date">
                            <i class="fa fa-calendar" for="from_date"></i>
                            <input type="text" placeholder="Check-in Date" value="@((ViewBag.checkInDate!="")?ViewBag.checkInDate:DateTime.Now.AddDays(2).ToString("dd-MM-yyyy"))" class="hol_ind_inputBox" id="check_in_date" name="check_in_date" readonly />
                        </div>
                        <div class="hol_ind_srch_subBox hol_inlg_datergt">
                            <i class="fa fa-calendar" for="to_date"></i>
                            <input type="text" placeholder="Check-Out Date" value="@((ViewBag.checkOutDate!="")?ViewBag.checkOutDate:DateTime.Now.AddDays(7).ToString("dd-MM-yyyy"))" class="hol_ind_inputBox" id="check_out_date" name="check_out_date" readonly />
                        </div>
                        <div class="hol_ind_srch_subBox hol_inlg_date prp_hotel_popup">
                            <div id="prsn_add_hotel">
                                <input type="text" name="txt_hotel_pax" id="txt_hotel_pax" placeholder="1 Room(s), 1 Adult(s), 0 Child(s)" class="hol_ind_inputBox" style="cursor:pointer;" readonly />
                                <i class="fa fa-angle-down"></i>
                            </div>
                            <div class="hol_person_dropdown" id="prsn_hotel_popup">
                                <ul class="slect_room">
                                    <li>
                                        <label>Room</label>
                                        <div class="count_persn">
                                            <a href="javascript:void(0);"><em data-field="room" data-opt="-" class="fa fa-minus inc_der"></em></a>
                                            <input type="text" value="1" readonly class="inpt_cout_persn" name="hotel_room" id="hotel_room" />
                                            <a href="javascript:void(0);"><em data-field="room" data-opt="+" class="fa fa-plus inc_der"></em></a>
                                        </div>
                                    </li>
                                </ul>
                                @for (int j = 1; j <= 6; j++)
                                {
                                    <div class="hotel_adult_count" id="adt_chd_@(j)" style="display:@((j==1)?"block":"none");">
                                        <ul>
                                            <li>
                                                <label>Adult </label>
                                                <div class="count_persn">
                                                    <a href="javascript:void(0);"><em data-field="adult_@(j)" data-opt="-" class="fa fa-minus inc_der"></em></a>
                                                    <input type="text" value="1" name="adult_@(j)" id="adult_@(j)" readonly class="inpt_cout_persn" />
                                                    <a href="javascript:void(0);"><em data-field="adult_@(j)" data-opt="+" class="fa fa-plus inc_der"></em></a>
                                                </div>
                                            </li>
                                            <li>
                                                <label>Child </label>
                                                <div class="count_persn">
                                                    <a href="javascript:void(0);"><em data-field="child_@(j)" data-opt="-" class="fa fa-minus inc_der"></em></a>
                                                    <input type="text" value="0" name="child_@(j)" id="child_@(j)" readonly class="inpt_cout_persn" />
                                                    <a href="javascript:void(0);"><em data-field="child_@(j)" data-opt="+" class="fa fa-plus inc_der"></em></a>
                                                </div>
                                            </li>
                                        </ul>
                                        <div class="hotel_chd_age" id="hotel_chd_age_@(j)" style="display:none;">
                                            <label class="chil_label">Child Age:</label>
                                            <span id="parnt_chl_age">
                                                <span id="parnt_child">
                                                    @for (int k = 1; k <= 4; k++)
                                                    {
                                                        <select name="child_@(j)_@(k)" id="child_@(j)_@(k)" class="hotel_chd_age_fld_@(j)">
                                                            <option value="">--</option>
                                                            <option value="1">01</option>
                                                            <option value="2">02</option>
                                                            <option value="3">03</option>
                                                            <option value="4">04</option>
                                                            <option value="5">05</option>
                                                            <option value="6">06</option>
                                                            <option value="7">07</option>
                                                            <option value="8">08</option>
                                                            <option value="9">09</option>
                                                            <option value="10">10</option>
                                                            <option value="11">11</option>
                                                        </select>
                                                    }
                                                </span>
                                            </span>
                                        </div>
                                    </div>
                                }
                                <div class="hol_clss_done" id="hol_ind_done">
                                    <a href="javascript:void(0);" id="prsn_done_hotel">Done</a>
                                </div>
                            </div>
                        </div>
                        <div class="hol_ind_srch_subBox hol_inlg_datergt">
                            <select class="hol_ind_inputBox" name="nationality" id="nationality">
                                <option value="">Select Country</option>
                                @foreach (Country country in ViewBag.countryList)
                                {
                                    <option @((country.Code.Equals("GB")) ? "selected" : "") value="@(country.Code)">@(country.Name)</option>
                                }
                            </select>

                        </div>
                        <input href="javascript:void(0);" name="hotel_submit" id="hotel_submit" type="submit" class="hol_ind_sbm_btn" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container">
    <div class="row">
        <div class="col-xs-12">
            <div class="hol_inx_body">
                <h3>Hotel for Viman</h3>
                <p>
                    Driven by the passion of travel we understand how difficult it is to find the suitable accommodation to a place where you want to enjoy a relaxing time with your family and friends. Just leave your worries behind as we at viman.co.uk work hard to bring out the cheapest prices on various categories of hotels from budget to luxurious, from five star villas to beach resorts, from unique homes to vacation rentals etc. so that you can have a memorable trip. Our huge selection of accommodation options will surely let you plan a perfect holiday trip. From adventure freaks to backpackers from honeymooners to family trips we have the best possible accommodation options for you. Our guaranteed bookings, 24X7 customer support help you to enjoy hassle-free holiday trip.
                </p>
                <h3>Why book with us</h3>
                <p>
                    Your hotel accommodation on your holiday trip is not just another room but a place where you prepare yourself for the countless adventures for a wonderful holiday experience. We search millions of properties across the world to offer you the best deals and put you right in the heart of it all. We offer you the accommodations to enjoy those countless experiences that you cherish throughout your lives.
                </p>
            </div>
        </div>
    </div>
</div>




