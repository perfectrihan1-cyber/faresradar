@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $("#car_submit").click(function () {
                if ($("#car_pickup_location").val().trim(' ') == "") {
                    alert("Please enter your pickup location");
                    $("#car_pickup_location").focus();
                    return false;
                }
                else if ($("#car_pickup_location").val().trim(' ').indexOf('-') != 3) {
                    alert("Kindly select pickup location from auto suggest list!");
                    $("#car_pickup_location").focus();
                    return false;
                }
                else if ($("#car_dropoff_location").val().trim(' ') == "") {
                    alert("Please enter your dropoff location");
                    $("#car_dropoff_location").focus();
                    return false;
                }
                else if ($("#car_dropoff_location").val().trim(' ').indexOf('-') != 3) {
                    alert("Kindly select dropoff location from auto suggest list!");
                    $("#car_dropoff_location").focus();
                    return false;
                } else {
                    var pickup = "&Pickup=" + $("#car_pickup_location_id").val();
                    var dropoff = "&Dropoff=" + $("#car_dropoff_location_id").val();
                    var pickupDate = "&PickupDate=" + $("#car_pickup_date").val().split("-")[2] + "-" + $("#car_pickup_date").val().split("-")[1] + "-" + $("#car_pickup_date").val().split("-")[0] + " " + $("#car_pickup_time").val();
                    var dropoffDate = "&DropoffDate=" + $("#car_dropoff_date").val().split("-")[2] + "-" + $("#car_dropoff_date").val().split("-")[1] + "-" + $("#car_dropoff_date").val().split("-")[0] + " " + $("#car_dropoff_time").val();

                    var str = "@(ViewBag.StaticURL + "car-hire/search?")SiteCode=VIMAN&SourceMedia=VIMAN" + pickup + dropoff + pickupDate + dropoffDate + "&Currency=GBP";
                    //alert(str);
                    var monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                    $("#cp_from_name").html($("#car_pickup_location").val().split("-")[1]);
                    $("#cp_from_code").html($("#car_pickup_location").val().split("-")[0]);
                    $("#cp_to_name").html($("#car_dropoff_location").val().split("-")[1]);
                    $("#cp_to_code").html($("#car_dropoff_location").val().split("-")[0]);
                    var pd_tp = $("#car_pickup_date").val().split("-");
                    $("#cp_pickup_date").html(pd_tp[0] + " " + monthNames[pd_tp[1] - 1] + ", " + pd_tp[2] + " " + $("#car_pickup_time").val());
                    var dd_tp = $("#car_dropoff_date").val().split("-");
                    $("#cp_dropoff_date").html(dd_tp[0] + " " + monthNames[dd_tp[1] - 1] + ", " + dd_tp[2] + " " + $("#car_dropoff_time").val());
                    $("#car_search_popup").show();

                    $('#car_plane').css({ 'left': '0%' }).animate({ 'left': '70%' }, 7000);
                    window.location = str;
                }
            });

            $('#car_pickup_location').autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/api/getlocation",
                        dataType: "json",
                        data: {
                            pickUpLocation: request.term
                        },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    value: item.LocationId,
                                    label: (item.CityCode + "-" + item.Name)
                                }
                            }));
                        }
                    })
                },
                open: function (event, ui) { selectLocation = false; },
                select: function (event, ui) {
                    $("#car_pickup_location").val(ui.item.label);
                    $("#car_pickup_location_id").val(ui.item.value);
                    selectLocation = false;
                    return false;
                },
                close: function (event, ui) {
                    selectLocation = false;
                },
                minLength: 3,
                autoFocus: true
            }).blur(function () {
                if (selectLocation) {
                    $("#car_pickup_location").val($('ul.ui-autocomplete li:first a').text());
                }
            }).focus(function () {
                $(this).autocomplete("search");
            });

            $('#car_dropoff_location').autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/api/getlocation",
                        dataType: "json",
                        data: {
                            pickUpLocation: request.term
                        },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    value: item.LocationId,
                                    label: (item.CityCode + "-" + item.Name)
                                }
                            }));
                        }
                    })
                },
                open: function (event, ui) { selectLocation = false; },
                select: function (event, ui) {
                    $("#car_dropoff_location").val(ui.item.label);
                    $("#car_dropoff_location_id").val(ui.item.value);
                    selectLocation = false;
                    return false;
                },
                close: function (event, ui) {
                    selectLocation = false;
                },
                minLength: 3,
                autoFocus: true
            }).blur(function () {
                if (selectLocation) {
                    $("#car_dropoff_location").val($('ul.ui-autocomplete li:first a').text());
                }
            }).focus(function () {
                $(this).autocomplete("search");
            });

            $("#car_pickup_date").datepicker({
                format: 'dd-mm-yyyy',
                startDate: '@DateTime.Now.AddDays(2).ToString("dd-MM-yyyy")',
                autoHide: true
            }).on('pick.datepicker', function (e) {
                var currdate = getStr(e.date.getDate()) + "-" + getStr((e.date.getMonth() + 1)) + "-" + e.date.getFullYear();
                $("#car_dropoff_date").val(currdate);
                $("#car_dropoff_date").datepicker('setDate', e.date);
                $("#car_dropoff_date").datepicker('setStartDate', e.date);
                $("#car_pickup_time").focus();
            });
            $("#car_dropoff_date").datepicker({
                format: 'dd-mm-yyyy',
                startDate: '@DateTime.Now.AddDays(9).ToString("dd-MM-yyyy")',
                autoHide: true
            });
            $("#car_pickup_time").datetimepicker({
                timepicker: true,
                datepicker: false,
                step: 5,
                format: 'H:i',
            });
            $("#car_dropoff_time").datetimepicker({
                timepicker: true,
                datepicker: false,
                step: 5,
                format: 'H:i',
            });
        });
    </script>
}