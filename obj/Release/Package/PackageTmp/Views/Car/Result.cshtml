@section scripts{
    <script type="text/javascript">
        $(function () {
            $("#car_submit").click(function () {
                if ($("#car_pickup_location").val().trim(' ') == "") {
                    alert("Please enter your pickup location");
                    $("#car_pickup_location").focus();
                    return false;
                }
                else if ($("#car_pickup_location").val().trim(' ').indexOf('-') != 3) {
                    alert("Kindly select pickup location from auto suggest list!");
                    $("#car_pickup_location").focus();
                    return false;
                }
                else if ($("#car_dropoff_location").val().trim(' ') == "") {
                    alert("Please enter your dropoff location");
                    $("#car_dropoff_location").focus();
                    return false;
                }
                else if ($("#car_dropoff_location").val().trim(' ').indexOf('-') != 3) {
                    alert("Kindly select dropoff location from auto suggest list!");
                    $("#car_dropoff_location").focus();
                    return false;
                } else {
                    var pickup = "&Pickup=" + $("#car_pickup_location_id").val();
                    var dropoff = "&Dropoff=" + $("#car_dropoff_location_id").val();
                    var pickupDate = "&PickupDate=" + $("#car_pickup_date").val().split("-")[2] + "-" + $("#car_pickup_date").val().split("-")[1] + "-" + $("#car_pickup_date").val().split("-")[0] + " " + $("#car_pickup_time").val();
                    var dropoffDate = "&DropoffDate=" + $("#car_dropoff_date").val().split("-")[2] + "-" + $("#car_dropoff_date").val().split("-")[1] + "-" + $("#car_dropoff_date").val().split("-")[0] + " " + $("#car_dropoff_time").val();

                    var str = "@(ViewBag.StaticURL + "car-hire/search?")SiteCode=VIMAN&SourceMedia=VIMAN" + pickup + dropoff + pickupDate + dropoffDate + "&Currency=GBP";
                    //alert(str);
                    var monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                    $("#cp_from_name").html($("#car_pickup_location").val().split("-")[1]);
                    $("#cp_from_code").html($("#car_pickup_location").val().split("-")[0]);
                    $("#cp_to_name").html($("#car_dropoff_location").val().split("-")[1]);
                    $("#cp_to_code").html($("#car_dropoff_location").val().split("-")[0]);
                    var pd_tp = $("#car_pickup_date").val().split("-");
                    $("#cp_pickup_date").html(pd_tp[0] + " " + monthNames[pd_tp[1] - 1] + ", " + pd_tp[2] + " " + $("#car_pickup_time").val());
                    var dd_tp = $("#car_dropoff_date").val().split("-");
                    $("#cp_dropoff_date").html(dd_tp[0] + " " + monthNames[dd_tp[1] - 1] + ", " + dd_tp[2] + " " + $("#car_dropoff_time").val());
                    $("#car_search_popup").show();

                    $('#car_plane').css({ 'left': '0%' }).animate({ 'left': '70%' }, 7000);
                    window.location = str;
                }
            });

            $('#car_pickup_location').autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/api/getlocation",
                        dataType: "json",
                        data: {
                            pickUpLocation: request.term
                        },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    value: item.LocationId,
                                    label: (item.CityCode + "-" + item.Name)
                                }
                            }));
                        }
                    })
                },
                open: function (event, ui) { selectLocation = false; },
                select: function (event, ui) {
                    $("#car_pickup_location").val(ui.item.label);
                    $("#car_pickup_location_id").val(ui.item.value);
                    selectLocation = false;
                    return false;
                },
                close: function (event, ui) {
                    selectLocation = false;
                },
                minLength: 3,
                autoFocus: true
            }).blur(function () {
                if (selectLocation) {
                    $("#car_pickup_location").val($('ul.ui-autocomplete li:first a').text());
                }
            }).focus(function () {
                $(this).autocomplete("search");
            });

            $('#car_dropoff_location').autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/api/getlocation",
                        dataType: "json",
                        data: {
                            pickUpLocation: request.term
                        },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    value: item.LocationId,
                                    label: (item.CityCode + "-" + item.Name)
                                }
                            }));
                        }
                    })
                },
                open: function (event, ui) { selectLocation = false; },
                select: function (event, ui) {
                    $("#car_dropoff_location").val(ui.item.label);
                    $("#car_dropoff_location_id").val(ui.item.value);
                    selectLocation = false;
                    return false;
                },
                close: function (event, ui) {
                    selectLocation = false;
                },
                minLength: 3,
                autoFocus: true
            }).blur(function () {
                if (selectLocation) {
                    $("#car_dropoff_location").val($('ul.ui-autocomplete li:first a').text());
                }
            }).focus(function () {
                $(this).autocomplete("search");
            });

            $("#car_pickup_date").datepicker({
                format: 'dd-mm-yyyy',
                startDate: '@DateTime.Now.AddDays(2).ToString("dd-MM-yyyy")',
                autoHide: true
            }).on('pick.datepicker', function (e) {
                var currdate = getStr(e.date.getDate()) + "-" + getStr((e.date.getMonth() + 1)) + "-" + e.date.getFullYear();
                $("#car_dropoff_date").val(currdate);
                $("#car_dropoff_date").datepicker('setDate', e.date);
                $("#car_dropoff_date").datepicker('setStartDate', e.date);
                $("#car_pickup_time").focus();
            });
            $("#car_dropoff_date").datepicker({
                format: 'dd-mm-yyyy',
                startDate: '@DateTime.Now.AddDays(9).ToString("dd-MM-yyyy")',
                autoHide: true
            });
            $("#car_pickup_time").datetimepicker({
                timepicker: true,
                datepicker: false,
                step: 5,
                format: 'H:i',
            });
            $("#car_dropoff_time").datetimepicker({
                timepicker: true,
                datepicker: false,
                step: 5,
                format: 'H:i',
            });

            $("#slider-range").slider({
                range: true,
                min: @(Model.MinPrice),
                max: @(Model.MaxPrice),
                values: [ @(Model.MinPrice), @(Model.MaxPrice) ],
                slide: function( event, ui ) {
                    $("#min_price_sp").html("£" + ui.values[0]);
                    $("#max_price_sp").html("£" + ui.values[1]);
                    $("#min_price").val(ui.values[0]);
                    $("#max_price").val(ui.values[1]);
                },
                stop: function( event, ui ) {
                    changeFilter();
                }
            });
            $("#min_price_sp").html("£" + $("#slider-range").slider("values", 0));
            $("#max_price_sp").html("£" + $("#slider-range").slider("values", 1));
            $("#min_price").val($("#slider-range").slider("values", 0));
            $("#max_price").val($("#slider-range").slider("values", 1));

            $("#btn_serch_show, #btn_serch_showMb").click(function () {
                $(".srch_box_srchPge_modify").slideToggle("slow");
            });

            // available filter
            $(".available_chk").change(function(e){
                if ($(this).prop('checked')==true)
                    $(this).parent("label").addClass("active");
                else
                    $(this).parent("label").removeClass("active");
                changeFilter();
            });
            $(".transmission_chk").change(function(e){
                if ($(this).prop('checked')==true)
                    $(this).parent("label").addClass("active");
                else
                    $(this).parent("label").removeClass("active");
                changeFilter();
            });
            $(".supplier_chk").change(function(e){
                if ($(this).prop('checked')==true)
                    $(this).parent("label").addClass("active");
                else
                    $(this).parent("label").removeClass("active");
                changeFilter();
            });
            $(".passenger_chk").change(function(e){
                if ($(this).prop('checked')==true)
                    $(this).parent("label").addClass("active");
                else
                    $(this).parent("label").removeClass("active");
                changeFilter();
            });

            $(".clear_filter").click(function(){
                clearFilter();
            });
        });

        function clearFilter()
        {
            $(".car_serch_mainBx").show();

            $(".available_chk").prop('checked',false);
            $(".available_chk").parent("label").removeClass("active");
            $(".transmission_chk").prop('checked',false);
            $(".transmission_chk").parent("label").removeClass("active");
            $(".supplier_chk").prop('checked',false);
            $(".supplier_chk").parent("label").removeClass("active");
            $(".passenger_chk").prop('checked',false);
            $(".passenger_chk").parent("label").removeClass("active");

            var options = $("#slider-range").slider( 'option' );
            $("#slider-range").slider( 'values', [ options.min, options.max ] );
            $("#min_price_sp").html("£" + options.min);
            $("#max_price_sp").html("£" + options.max);
            $("#min_price").val(options.min);
            $("#max_price").val(options.max);

            $(".main_no_found").hide();
        }

        function changeFilter()
        {
            $(".main_no_found").hide();

            var minp = parseFloat($("#min_price").val());
            var maxp = parseFloat($("#max_price").val());

            var ava_arr = [];
            $('input[name=available_chk]:checked').map(function() {
                ava_arr.push($(this).val());
            });
            var tra_arr = [];
            $('input[name=transmission_chk]:checked').map(function() {
                tra_arr.push($(this).val());
            });
            var sup_arr = [];
            $('input[name=supplier_chk]:checked').map(function() {
                sup_arr.push($(this).val());
            });
            var pas_arr = [];
            $('input[name=passenger_chk]:checked').map(function() {
                pas_arr.push($(this).val());
            });

            $(".car_serch_mainBx").hide();
            var main_flag = true;

            $(".car_serch_mainBx").each(function(i) {
                // price filter
                var price_flag = false;
                if(parseFloat($(this).attr("data-price"))>=minp && parseFloat($(this).attr("data-price"))<=maxp)
                    price_flag = true;

                // available filter
                var avail_flag = false;
                if(ava_arr=="")
                    avail_flag = true;
                else if($.inArray($(this).attr("data-availability"),ava_arr)!=-1)
                    avail_flag = true;

                // transmission filter
                var trans_flag = false;
                if(tra_arr=="")
                    trans_flag = true;
                else if($.inArray($(this).attr("data-transmission"),tra_arr)!=-1)
                    trans_flag = true;

                // supplier filter
                var supp_flag = false;
                if(sup_arr=="")
                    supp_flag = true;
                else if($.inArray($(this).attr("data-supplier"),sup_arr)!=-1)
                    supp_flag = true;

                // passenger filter
                var pass_flag = false;
                if(pas_arr=="")
                    pass_flag = true;
                else if($.inArray($(this).attr("data-passenger"),pas_arr)!=-1)
                    pass_flag = true;

                if(price_flag && avail_flag && trans_flag && supp_flag && pass_flag)
                {
                    $(this).show();
                    main_flag = false;
                }
            });

            if(main_flag)
            {
                $(".main_no_found").show();
            }
        }

        $("#btn_serch_show").click(function () {
            $(".car_srch_searBx").slideToggle("slow");
        });
    </script>
}

