                                <input type="checkbox" class="airline_flt passenger_chk" name="passenger_chk" id="passenger_4" value="4">
                                <span class="checkmark"></span>
                                <bdo>4</bdo>
                            </label>
                        </div>
                        <div class="car_loc">
                            <label class="loc_car_chkbox" for="passenger_5">
                                <input type="checkbox" class="airline_flt passenger_chk" name="passenger_chk" id="passenger_5" value="5">
                                <span class="checkmark"></span>
                                <bdo>5</bdo>
                            </label>
                        </div>
                        <div class="car_loc">
                            <label class="loc_car_chkbox" for="passenger_7">
                                <input type="checkbox" class="airline_flt" name="passenger_chk" id="passenger_7" value="7">
                                <span class="checkmark"></span>
                                <bdo>7</bdo>
                            </label>
                        </div>
                        <div class="car_loc">
                            <label class="loc_car_chkbox" for="passenger_8">
                                <input type="checkbox" class="airline_flt passenger_chk" name="passenger_chk" id="passenger_8" value="8">
                                <span class="checkmark"></span>
                                <bdo>8</bdo>
                            </label>
                        </div>
                        <div class="car_loc">
                            <label class="loc_car_chkbox" for="passenger_12">
                                <input type="checkbox" class="airline_flt passenger_chk" name="passenger_chk" id="passenger_12" value="12">
                                <span class="checkmark"></span>
                                <bdo>12</bdo>
                            </label>
                        </div>
                    </div>
                    <div class="car_pannel clearfix">
                        <div class="slc_flrt_all">
                            <span><a href="javascript:void(0);" class="clear_filter">Clear All</a></span>
                        </div>
                        <h4><i class="fa fa-map-marker"></i>Fuel Policy</h4>
                        <div class="car_loc">
                            <label class="loc_car_chkbox" for="car_petrl">
                                <input type="checkbox" class="airline_flt" name="airline_chk" id="car_petrl" value="AI">
                                <span class="checkmark"></span>
                                <bdo>Petrol</bdo>
                            </label>
                        </div>
                        <div class="car_loc">
                            <label class="loc_car_chkbox" for="diesL">
                                <input type="checkbox" class="airline_flt" name="airline_chk" id="diesL" value="AI">
                                <span class="checkmark"></span>
                                <bdo>Diesel</bdo>
                            </label>
                        </div>
                    </div>
                    <div class="car_pannel clearfix">
                        <div class="slc_flrt_all">
                            <span><a href="javascript:void(0);" class="clear_filter">Clear All</a></span>
                        </div>
                        <h4><i class="fa fa-map-marker"></i>Location</h4>
                        <div class="car_loc">
                            <label class="loc_car_chkbox" for="onairp">
                                <input type="checkbox" class="airline_flt" name="asdf" id="onairp" value="AI">
                                <span class="checkmark"></span>
                                <bdo>On Airport</bdo>
                            </label>
                        </div>
                        <div class="car_loc">
                            <label class="loc_car_chkbox" for="offAirp">
                                <input type="checkbox" class="airline_flt" name="airline_chk" id="offAirp" value="AI">
                                <span class="checkmark"></span>
                                <bdo>Off Airport</bdo>
