                                <p></p>
                            </div>
                            <div class="prc_dtlmBx">
                                <div class="prc_dtl">
                                    <h2>@(ViewBag.Currency)@(cars.TotalCost.ToString("0"))</h2>
                                    <a href="@(ViewBag.StaticURL + "car/detail/?sess=" + cars.CarId)" data-id="@(cars.CarId)" class="book_car_btn">Book Now</a>
