                                        <li><i class="passenger"></i> <bdo>Up to @(cars.Adult + cars.Child + cars.Infant) Passengers</bdo></li>
                                        <li><i class="transmission"></i> <bdo>@((cars.Transmission == "A") ? "Automatic" : "Manual") Transmission</bdo></li>
