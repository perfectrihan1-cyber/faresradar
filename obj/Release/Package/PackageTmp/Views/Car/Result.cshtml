                            <label class="loc_car_chkbox" for="available_1">
                                <input type="checkbox" class="airline_flt available_chk" name="available_chk" id="available_1" value="True">
                                <span class="checkmark"></span>
                                <bdo>Available</bdo>
                            </label>
