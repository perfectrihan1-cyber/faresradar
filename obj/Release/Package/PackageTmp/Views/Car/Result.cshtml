                        <div class="car_loc">
                            <label class="loc_car_chkbox" for="available_2">
                                <input type="checkbox" class="airline_flt available_chk" name="available_chk" id="available_2" value="True">
                                <span class="checkmark"></span>
                                <bdo>On Request</bdo>
                            </label>
                        </div>
                    </div>
                    <div class="car_pannel clearfix">
                        <div class="slc_flrt_all">
                            <span><a href="javascript:void(0);" class="clear_filter">Clear All</a></span>
                        </div>

                        <h4><i class="fa fa-map-marker"></i>Transmission</h4>
                        <div class="car_loc">
                            <label class="loc_car_chkbox" for="transmission_1">
                                <input type="checkbox" class="airline_flt transmission_chk" name="transmission_chk" id="transmission_1" value="A">
                                <span class="checkmark"></span>
                                <bdo>Automatic</bdo>
