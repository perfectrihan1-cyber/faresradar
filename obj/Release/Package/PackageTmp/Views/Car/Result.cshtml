                    </div>
                </div>
            </div>
            <div class="col-md-9 col-sm-8">
                <div class="car_srch_contner">
                    <h3 class="car_cont_hd">@(Model.CarsList.Count) cars found in @(Model.CarsSearch.FromLocation.CityName)</h3>
                </div>

                @foreach (Cars cars in Model.CarsList)
                {
                    <div class="car_serch_mainBx" data-passenger="@(cars.Adult+cars.Child+cars.Infant)" data-transmission="@(cars.Transmission)" data-availability="@(cars.OnRequest)" data-supplier="@(cars.Supplier)" data-price="@(cars.TotalCost)">
