@model Viman.Models.CarsResult
@using Viman.Models
@{
    ViewBag.Title = "Result";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.WebsiteURL = Common.WebsiteURL;
    ViewBag.StaticURL = Common.StaticURL;
    ViewBag.Currency = Common.Currency;
}

<div class="background_top"></div>
<div class="container">
    <div class="row">
        <div class="col-xs-12">
            <div class="car_top_summry">
                <div class="car_modify_button">
                    <a href="javascript:void(0);" id="btn_serch_show">
                        MODIFY
                        <i class="fa fa-angle-down"></i>
                    </a>
                </div>
                <ul class="car_main_li_summry clearfix">
                    <li>
                        <div class="car_top_smy_des">
                            <span>Car Hire in @(Model.CarsSearch.FromLocation.CityName)</span>
                        </div>
                    </li>
                    <li>
                        <div class="car_top_smy_date">
                            <span>@(Model.CarsSearch.PickupDate.ToString("ddd dd MMM, HH:mm")) &nbsp; to&nbsp; <bdo>@(Model.CarsSearch.DropoffDate.ToString("ddd dd MMM, HH:mm"))</bdo></span>
                        </div>
                    </li>
                </ul>
                <div class="car_srch_searBx">
                    <div class="car_ind_srch_subBox">
                        <i class="fa fa-map-marker"></i>
                        <input type="hidden" name="car_pickup_location_id" id="car_pickup_location_id" value="@(ViewBag.pickupCode)" />
                        <input type="text" name="car_pickup_location" id="car_pickup_location" placeholder="Location/City" class="car_ind_inputBox" value="@(ViewBag.pickupName)" />
                    </div>
                    <div class="car_ind_srch_subBox">
                        <i class="fa fa-map-marker"></i>
                        <input type="hidden" name="car_dropoff_location_id" id="car_dropoff_location_id" value="@(ViewBag.dropoffCode)" />
                        <input type="text" name="car_dropoff_location" id="car_dropoff_location" placeholder="Location/City" class="car_ind_inputBox" value="@(ViewBag.dropoffName)" />
                    </div>
                    <div class="car_ind_srch_subBox_dt">
                        <i class="fa fa-map-marker"></i>
                        <input type="text" name="car_pickup_date" id="car_pickup_date" placeholder="Pickup Date" value="@((ViewBag.pickupDate==" ")?DateTime.Now.AddDays(2).ToString(" dd-MM-yyyy"):ViewBag.pickupDate)" class="car_ind_inputBox" />
                    </div>
                    <div class="car_ind_srch_subBox_tm">
                        <i class="fa fa-clock-o"></i>
                        <input type="text" name="car_pickup_time" id="car_pickup_time" placeholder="Time" value="@((ViewBag.pickupTime==" ")?DateTime.Now.AddDays(2).ToString(" HH:mm"):ViewBag.pickupTime)" class="car_ind_inputBox" />
                    </div>
                    <div class="car_ind_srch_subBox_dt">
                        <i class="fa fa-map-marker"></i>
                        <input type="text" name="car_dropoff_date" id="car_dropoff_date" placeholder="Dropoff Date" value="@((ViewBag.dropoffDate==" ")?DateTime.Now.AddDays(9).ToString(" dd-MM-yyyy"):ViewBag.dropoffDate)" class="car_ind_inputBox" />
                    </div>
                    <div class="car_ind_srch_subBox_tm">
                        <i class="fa fa-clock-o"></i>
                        <input type="text" name="car_dropoff_time" id="car_dropoff_time" placeholder="Time" value="@((ViewBag.dropoffTime==" ")?DateTime.Now.AddDays(9).ToString(" HH:mm"):ViewBag.dropoffTime)" class="car_ind_inputBox" />
                    </div>
                    <input type="button" src="javascript:void(0);" name="car_submit" id="car_submit" class="car_ind_sbm_btn" value="CAR SEARCH">
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.msg.Equals("noresult") || Model.CarsList == null)
{
    ViewBag.msg = "noresult";
    <div class="row">
        <div class="col-md-12">
            <div class="no_result">
                <i class="fa fa-frown-o"></i>
                <p>No results found for your selection. Click <b style="color:#f6921d;">MODIFY</b> to change your search.</p>
            </div>
        </div>
    </div>
}
@if (ViewBag.msg.Equals("success") && Model.CarsList != null)
{
    <div class="container">
        <div class="row">
            <div class="col-md-3 col-sm-4">
                <div class="car_lft_pnl">
                    <div class="car_head">
