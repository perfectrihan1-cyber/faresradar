        <script type="text/javascript">
        $(document).ready(function () {
            $(function () {
                $("#flight_from_date").datepicker({
                    minDate: '+0D',
                    maxDate: '+15M +1D',
                    dateFormat: 'dd-mm-yy',
                    showButtonPanel: true,
                    showAnim: '',
