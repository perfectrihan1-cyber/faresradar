                        window._skyActiveDateField = 'flight_from_date';
                        window._skyActiveDateLabel = 'Select a departure date';
                        $('#ui-datepicker-div').css('visibility', 'hidden');
                        setTimeout(applySkyCalendarLayout, 0);
                    },
                    onChangeMonthYear: function () { setTimeout(applySkyCalendarLayout, 0); },
                    onClose: function () {
