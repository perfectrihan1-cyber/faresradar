                            }, 0)
                        }
                    })
                });
            });
            $(function () {
                $("#flight_to_date").datepicker({
                    minDate: -0, maxDate: '+15M +1D',
                    dateFormat: 'dd-mm-yy',
                    showButtonPanel: true,
                    showAnim: '',
                    closeText: 'Apply',
                    numberOfMonths: 2,
                    beforeShow: customRange,
                    onChangeMonthYear: function () { setTimeout(applySkyCalendarLayout, 0); },
                    onClose: function () {
                        $('body').removeClass('sky-cal-lock');
                        $('#ui-datepicker-div').removeClass('sky-mobile-open').css('visibility', 'hidden');
                    },
                    onSelect: (function (date) {
                        $("#flight_to_date").val(date);
                    })
                });
            });

            // Measures the real bottom-most / left-most edge among the actual
            // search-bar fields themselves (not a wrapping div). This sidesteps
            // ANY wrapper (.search-box, #searchFields, etc.) whose own box may
            // have collapsed to near-zero height due to floated/absolutely
            // positioned children or negative-margin overlap tricks used for
            // the hero design — which is what was pulling the calendar up to
            // overlap the pills row instead of sitting below the whole bar.
            // These specific IDs are guaranteed to exist wherever this script
            // runs, since the datepicker is bound directly to #flight_from_date
            // / #flight_to_date above.
            function getSearchRowRect() {
                var ids = ['flight_from', 'flight_to', 'flight_from_date', 'flight_to_date', 'flight_submit'];
                var containerSelectors = ['.search-box', '.search-fields', '#fieldGroup'];
                var left = null, bottom = null;

                for (var i = 0; i < ids.length; i++) {
                    var el = document.getElementById(ids[i]);
                    if (!el) continue;

                    var r = el.getBoundingClientRect();
                    if (r.width === 0 && r.height === 0) continue; // hidden field (e.g. Return on one-way)

                    if (left === null || r.left < left) { left = r.left; }
                    if (bottom === null || r.bottom > bottom) { bottom = r.bottom; }
                }

                // Also measure the whole search-bar wrapper(s). On some layouts the
                // individual inputs sit high inside their pill (their own bounding
                // box ends before the pill's visible bottom edge, because of the
                // negative-margin label trick), which was letting the calendar
                // dock too high and overlap the bar instead of sitting below it.
                // Taking the max/min across BOTH individual fields and containers
                // guarantees we always clear the full visible bar.
                for (var j = 0; j < containerSelectors.length; j++) {
                    var cel = document.querySelector(containerSelectors[j]);
                    if (!cel) continue;

                    var cr = cel.getBoundingClientRect();
                    if (cr.width === 0 && cr.height === 0) continue;

                    if (left === null || cr.left < left) { left = cr.left; }
                    if (bottom === null || cr.bottom > bottom) { bottom = cr.bottom; }
                }

                if (left === null) return null;
                return { left: left, bottom: bottom };
            }

            // Forces the Skyscanner-style 2-month grid layout via inline styles,
            // so it can never be overridden by jquery-ui.css/jquery-ui.min.css
            // loading after inner.css in _Layout. Every child is explicitly pinned
            // to its cell so a stray/extra node (e.g. jQuery UI's own clearfix div)
            // can never shift the auto-placement order.
            function isMobileCalendar() {
                return window.matchMedia('(max-width: 610px)').matches;
            }

            // Full-screen, Skyscanner-app-style layout for small screens: a fixed
            // header (back arrow + title), a scrollable body holding the month(s)
            // stacked vertically, and the existing buttonpane pinned as a sticky
            // footer. Runs instead of the desktop 2-up grid layout below.
            function applyMobileCalendarLayout($dp) {
                // Move it back to <body> — on desktop it gets parked inside
                // #searchFields (position:relative) so top:100% can dock it; but
                // position:fixed only behaves reliably relative to the viewport
                // when its parent chain has no transform/relative quirks, so on
                // mobile we always want it living directly under <body>.
                if ($dp.parent()[0] !== document.body) {
                    document.body.appendChild($dp[0]);
                }

                // Clear any desktop inline styles a previous (wider) layout pass
                // may have applied, so the mobile CSS media query can take over.
                $dp.css({
                    position: '', top: '', left: '', right: '', margin: '', zIndex: '',
                    display: '', gridTemplateColumns: '', gridAutoRows: '', columnGap: '', rowGap: '',
                    width: '', minWidth: '', maxWidth: '', padding: '', border: '', borderRadius: '', boxShadow: ''
                });
                $dp.children().each(function () {
                    $(this).css({ gridColumn: '', gridRow: '', width: '', cssFloat: '', margin: '', padding: '', boxSizing: '', display: '' });
                });

                var title = 'Choose dates';

                if (!$dp.find('.sky-mob-header').length) {
                    var $header = $(
                        '<div class="sky-mob-header">' +
                            '<button type="button" class="sky-mob-back" aria-label="Close">&#8592;</button>' +
                            '<div class="sky-mob-title">' + title + '</div>' +
                            '<span class="sky-mob-spacer"></span>' +
                        '</div>'
                    );
                    $dp.prepend($header);
                    $header.find('.sky-mob-back').on('click', function () {
                        if (window._skyActiveDateField) {
                            $('#' + window._skyActiveDateField).datepicker('hide');
                        }
                    });
                }

                if (!$dp.find('.sky-mob-body').length) {
                    $dp.children()
                        .not('.sky-mob-header')
                        .not('.ui-datepicker-buttonpane')
                        .wrapAll('<div class="sky-mob-body"></div>');
                }

                $dp.find('.ui-datepicker-buttonpane').attr('data-label', window._skyActiveDateLabel || 'Select a date');

                $dp.addClass('sky-mobile-open');
                $('body').addClass('sky-cal-lock');
            }

            function applySkyCalendarLayout() {
                // Re-entrancy guard: the styles this function sets are watched
                // by the MutationObserver below (so it can reposition on month
                // change / scroll / resize). Without this guard, every style
                // change we make here would itself trigger the observer, which
                // would call this function again, which changes styles again —
                // an infinite loop that hangs the tab. The flag is released on
                // the next tick, after the browser has already delivered (and
                // our observer has already ignored) any mutation records caused
                // by the assignments below.
                if (window._skyApplyingCalendarLayout) return;
                window._skyApplyingCalendarLayout = true;

                var $dp = $('#ui-datepicker-div');
                if (!$dp.length) { window._skyApplyingCalendarLayout = false; return; }

                if (isMobileCalendar()) {
                    applyMobileCalendarLayout($dp);
                    $dp.css('visibility', 'visible');
                    setTimeout(function () { window._skyApplyingCalendarLayout = false; }, 0);
                    return;
                }

                // Desktop only past this point: make sure nothing left over from a
                // mobile layout pass (header/body wrapper, scroll lock) lingers if
                // the viewport was resized back up while the calendar is open.
                $('body').removeClass('sky-cal-lock');
                $dp.removeClass('sky-mobile-open');
                if ($dp.find('.sky-mob-header').length || $dp.find('.sky-mob-body').length) {
                    $dp.find('.sky-mob-body').children().unwrap();
                    $dp.find('.sky-mob-header').remove();
                }

                // Always dock the calendar below the WHOLE search bar, Skyscanner-
                // style.
                // Always park the calendar directly under <body> and position it
                // with an exact pixel offset computed from getBoundingClientRect().
                // We previously tried to make it a real child of the search bar
                // and rely on CSS "top: 100%" (relative positioning), but that
                // depends on the search bar actually having position:relative in
                // the final computed style — if any other stylesheet on the page
                // forces position:static (even accidentally, via !important),
                // the browser falls back to a much higher-up positioned ancestor
                // as the containing block, and the calendar ends up rendered far
                // away from the search bar (that's the "calendar galat jagah aa
                // raha hai" bug). Computing an absolute pixel position from the
                // search bar's actual on-screen box sidesteps that entirely —
                // it doesn't matter what "position" anything computes to.
                if ($dp.parent()[0] !== document.body) {
                    document.body.appendChild($dp[0]);
                }

                var $anchor = $('.search-fields').first();
                var anchorRect = $anchor.length ? $anchor[0].getBoundingClientRect() : null;
                var rowRect = (anchorRect && (anchorRect.width || anchorRect.height))
                    ? { left: anchorRect.left, bottom: anchorRect.bottom }
                    : getSearchRowRect();

                if (rowRect) {
                    var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                    var scrollLeft = window.pageXOffset || document.documentElement.scrollLeft;

                    $dp.css({
                        position: 'absolute',
                        top: (rowRect.bottom + scrollTop + 12) + 'px',
                        left: (rowRect.left + scrollLeft) + 'px',
                        right: 'auto',
                        margin: 0,
                        zIndex: 9999
                    });
                }

                $dp.css({
                    display: 'grid',
                    gridTemplateColumns: '300px 300px',
                    gridAutoRows: 'auto',
                    columnGap: '44px',
                    rowGap: '0px',
                    width: 'auto',
                    minWidth: '0',
                    maxWidth: 'none',
                    padding: '20px 20px 0 20px',
                    border: '1px solid #e5e7eb',
                    borderRadius: '16px',
                    boxShadow: '0 12px 40px rgba(0,0,0,0.16)'
                });

                $dp.children().each(function () {
                    var $el = $(this);
                    if ($el.hasClass('ui-datepicker-group-first')) {
                        $el.css({ gridColumn: '1', gridRow: '1', width: '300px', cssFloat: 'none', margin: 0, padding: 0, boxSizing: 'border-box' });
                    } else if ($el.hasClass('ui-datepicker-group-last') || $el.hasClass('ui-datepicker-group-middle')) {
                        $el.css({ gridColumn: '2', gridRow: '1', width: '300px', cssFloat: 'none', margin: 0, padding: 0, boxSizing: 'border-box' });
                    } else if ($el.hasClass('ui-datepicker-buttonpane')) {
                        $el.css({ gridColumn: '1 / -1', gridRow: '2' });
                    } else {
                        // any other stray node (e.g. jQuery UI's own trailing clearfix div)
                        $el.css({ display: 'none' });
                    }
                });

                $dp.find('.ui-datepicker-title').css({
                    color: '#000000',
                    fontWeight: '700'
                });

                $dp.find('.ui-datepicker-buttonpane').attr('data-label', window._skyActiveDateLabel || 'Select a date');

                $dp.css('visibility', 'visible');
                setTimeout(function () { window._skyApplyingCalendarLayout = false; }, 0);
            }

            function isCalendarOpen() {
                var dp = document.getElementById('ui-datepicker-div');
                return !!(dp && dp.style.display !== 'none' && dp.offsetParent !== null);
            }

            // Reliable trigger: instead of racing jQuery UI's own show/position
            // logic with a setTimeout(0) from beforeShow, watch the DOM directly
            // for the calendar becoming visible and reposition it below the
            // WHOLE search bar every single time that happens (initial open,
            // month change, or any other internal jQuery UI re-render). Also
            // keeps it docked correctly if the page scrolls/resizes while open.
            if (!window._skyCalendarWatcherStarted) {
                window._skyCalendarWatcherStarted = true;

                var skyCalendarObserver = new MutationObserver(function () {
                    if (window._skyApplyingCalendarLayout) return;
                    if (isCalendarOpen()) { applySkyCalendarLayout(); }
                });
                skyCalendarObserver.observe(document.body, {
                    childList: true,
                    subtree: true,
                    attributes: true,
                    attributeFilter: ['style']
                });

                $(window).on('scroll resize', function () {
                    if (isCalendarOpen()) { applySkyCalendarLayout(); }
                });
            }

            function customRange(a) {
                var b = new Date();
                var c = new Date(b.getFullYear(), b.getMonth(), b.getDate());
                window._skyActiveDateField = a.id;
                window._skyActiveDateLabel = (a.id == 'flight_to_date') ? 'Select a return date' : 'Select a departure date';
                $('#ui-datepicker-div').css('visibility', 'hidden');
                if (a.id == 'flight_to_date') {
                    if ($("#flight_from_date").datepicker('getDate') != null) {
                        c = $("#flight_from_date").datepicker('getDate');
                    }
                }
                setTimeout(applySkyCalendarLayout, 0);
                return {
                    minDate: c = new Date(c.getFullYear(), c.getMonth(), c.getDate())
                }
            }

            $("#flight_submit").click(function () {
                debugger;
                if ($("#flight_from").val().trim(' ') == "") {
                    alert("Please enter your departure airport");
                    $("#flight_from").focus();
                    return false;
                }
                else if ($("#flight_from").val().trim(' ').indexOf('-') != 3) {
                    alert("Kindly select departure airport from auto suggest list!");
                    $("#flight_from").focus();
                    return false;
                }
                else if ($("#flight_to").val().trim(' ').trim(' ') == "") {
                    alert("Please enter your destination airport");
                    $("#flight_to").focus();
                    return false;
                }
                else if ($("#flight_to").val().trim(' ').indexOf('-') != 3) {
                    alert("Kindly select destination airport from auto suggest list!");
                    $("#flight_to").focus();
                    return false;
                }
                else if ($("#flight_to").val().trim(' ') == $("#flight_from").val().trim(' ')) {
                    alert("Departure Airport and Destination Airport can't be same!!");
                    $("#flight_to").focus();
                    return false;
                }
                else {
                    var fway = $('input[name=flight_way]:checked').val();
                    var fcls = $('input[name=flight_class]:checked').val();
                    var from = "&From=" + $("#flight_from").val().split("-")[0];
                    var to = "&To=" + $("#flight_to").val().split("-")[0];
                    var fromDate = "&DepDate=" + $("#flight_from_date").val().split("-")[2] + "-" + $("#flight_from_date").val().split("-")[1] + "-" + $("#flight_from_date").val().split("-")[0];
                    var toDate = "&RetDate=";
                    $("#spFrom").text($("#flight_from").val().split("-")[0]);
                    $("#spTo").text($("#flight_to").val().split("-")[0]);
                    $("#spFromDate").text($("#flight_from_date").val());
                    $("#spFLightway").hide();

                    if (fway == "2") {
                        toDate = "&RetDate=" + $("#flight_to_date").val().split("-")[2] + "-" + $("#flight_to_date").val().split("-")[1] + "-" + $("#flight_to_date").val().split("-")[0];
                        $("#spToDate").text($("#flight_to_date").val());
                        $("#spTo2").text($("#flight_from").val().split("-")[0]);
                        $("#spFrom2").text($("#flight_to").val().split("-")[0]);
                        $("#spFLightway").show();
                    }

                    var adultCount = (parseInt($("#flight_adult").val()) || 0) + (parseInt($("#flight_ss").val()) || 0);
                    var childCount = parseInt($("#flight_child").val()) || 0;
                    var infantCount = (parseInt($("#flight_infant").val()) || 0) + (parseInt($("#flight_aa").val()) || 0);

                    var adult = "&Adult=" + adultCount;
                    var child = "&Child=" + childCount;
                    var infant = "&Infant=" + infantCount;

                    $("#spADT").text(adultCount);
                    $("#spCHD").text(childCount);
                    $("#spINF").text(infantCount);

                    var airline = "&Airline=" + "";
                    var isdirect = "&IsDirect=" + (($("input[name=is_direct]:checked").val() == "1") ? "true" : "false");
                    var isflexi = "&IsFlexi=" + (($("input[name=flight_flexi]:checked").val() == "1") ? "true" : "false");
                    fway_s = "&FlightWay=" + fway;
                    fcls_s = "&FlightClass=" + fcls;
                    var tolPass = $("#ddlAdult").val() + "Adult," + $("#ddlChild").val() + "Child," + $("#ddlInfant").val() +"Infant";
                    $("#spPass").text(tolPass);
                    var str = "/flight/search?SiteCode=VIMAN&SourceMedia=VIMAN" + from + to + fromDate + toDate + adult + child + infant + fway_s + fcls_s + airline + isdirect + isflexi + "&Currency=USD";
                    $("#search_popup").show();
                    window.location = str;
                }
            });
            var selectFrom = false;
            var selectTo = false;

        });
                  $(".booking_btn").click(function () {
              var flight_opt = $(this).data("id");
                var fway = "2";
