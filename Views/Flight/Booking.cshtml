@model Viman.Models.FlightsBooking
@using Viman.Models
@{
    ViewBag.Title = "Booking";
    Layout = "~/Views/Shared/_Layoutinner.cshtml";
    ViewBag.WebsiteURL = Common.WebsiteURL;
    ViewBag.StaticURL = Common.StaticURL;
    ViewBag.Currency = Common.Currency;
    FlightsSearch flightSearch = ViewBag.flightSearch;
    Flights flights = ViewBag.flights;

    int mm = 0, nn = 0, pass = 0;

   


    double fare = 0;
    string flightid = "";
    foreach (FlightsSegment outboundArr in flights.Outbound)
    {

        fare = Convert.ToDouble(flights.TotalCost.ToString("0.00"));

        flightid = flights.FlightId;

    }
    if (flightSearch.FlightWay == FlightWay.RoundTrip)
    {

        foreach (FlightsSegment inboundArr in flights.Inbound)
        {

            fare = Convert.ToDouble(flights.TotalCost.ToString("0.00"));

            flightid = flights.FlightId;

        }


    }

   

}
<link rel="stylesheet" href="~/css1/booking.css">

<style>
    .partner-body {
        padding: 25px;
        background: #fafafa;
        border-radius: 8px;
    }

    .partner-message {
        font-size: 16px;
        color: #333;
        line-height: 26px;
        text-align: center;
        margin-bottom: 20px;
    }

    .partner-note {
        background: #fff8e5;
        border-left: 5px solid #f0ad4e;
        padding: 15px;
        color: #555;
        font-size: 14px;
        line-height: 22px;
        border-radius: 4px;
        margin-bottom: 20px;
    }

    .partner-confirm {
        text-align: center;
        font-size: 17px;
        font-weight: 600;
        color: #222;
        margin: 0;
    }

    .modal-header {
        background: #0d6efd;
        color: #fff;
        border-radius: 6px 6px 0 0;
    }

    .modal-title {
        font-weight: 600;
    }
</style>
