    <div class="right-col">

        <div class="right-card">
            <div class="right-card-header">
                Flight details <span>all times local</span>
            </div>

            <!-- OUTBOUND HEADER -->
            <div style="background:#fff8f0;padding:7px 16px;border-bottom:1px solid #ffe4c4;
                display:flex;justify-content:space-between;align-items:center">

                <span style="font-size:10px;font-weight:700;color:#c2410c;text-transform:uppercase">
                    ✈ Outbound —
                    @flights.Outbound.First().DepartureDate.ToString("ddd, dd MMM")
                </span>

                <span style="font-size:12px;font-weight:700;color:#0e1b4d">
                    $@(flights.TotalCost.ToString("0.00"))
                </span>
            </div>

            @{
                int cntOB = 1;

                foreach (var outboundArr in flights.Outbound)
                {
                    double stop_time = 0;

                    if (cntOB < flights.Outbound.Count)
                    {
                        stop_time = double.Parse(Common.GetTime(
                            flights.Outbound[cntOB].DepartureDate,
                            outboundArr.ArrivalDate).ToString());
                    }


                    <div class="flight-seg" style="padding:12px 16px;">

                        <div class="seg-direction" style="color:#0770e3;font-weight:600">

                            @(outboundArr.FromAirport.Code) →
                            @outboundArr.ToAirport.Code

                            <span style="color:#718096;font-weight:400">

                                · @(flights.Outbound.Count - 1) stop(s)

                                ·
                                @(Math.Floor(double.Parse(outboundArr.TotalTime) / 60))h
                                @(double.Parse(outboundArr.TotalTime) % 60)m

                            </span>

                        </div>

                        <div class="seg-row">

                            <div>
                                <div class="seg-airport">
                                    @outboundArr.FromAirport.Code
                                </div>

                                <div class="seg-time">
                                    @outboundArr.DepartureDate.ToString("HH:mm")
                                </div>
                            </div>

                            <div class="seg-mid-col">

                                <div class="seg-line-wrap">

                                    <div class="s-dot"></div>

                                    <div class="s-line"></div>

                                    <div class="seg-plane">✈</div>

                                    <div class="s-line"></div>

                                    <div class="s-dot"></div>

                                </div>

                            </div>

                            <div style="text-align:right">

                                <div class="seg-airport">
                                    @outboundArr.ToAirport.Code
                                </div>

                                <div class="seg-time">
                                    @outboundArr.ArrivalDate.ToString("HH:mm")
                                </div>

                            </div>

                        </div>

                        <div style="font-size:10px;color:#4a5568;margin-top:6px;line-height:1.7">

                            Depart:
                            @outboundArr.DepartureDate.ToString("ddd, dd-MMM")

                            ·

                            Arrive:
                            @outboundArr.ArrivalDate.ToString("ddd, dd-MMM")

                            <br>

                            <b>From:</b>
                            Terminal @outboundArr.FromTerminal
                            @outboundArr.FromAirport.Name

                            <br>

                            <b>To:</b>
                            Terminal @outboundArr.ToTerminal
                            @outboundArr.ToAirport.Name

                        </div>

                        <div style="font-size:10px;color:#4a5568;margin-top:5px">

                            @outboundArr.Airline.Name

                            @outboundArr.CabinClass

                            ·

                            @outboundArr.Airline.Code-@outboundArr.FlightNo

                            <br>

                            🧳
                            @outboundArr.BaggageAllowance

                            Cabin : 7 KG

                        </div>

                    </div>

                    if (cntOB < flights.Outbound.Count)
                    {
                        <div style="background:#f0fdf4;padding:5px 16px;text-align:center;
                    font-size:10px;color:#166534;font-weight:600;
                    border-top:1px dashed #bbf7d0;
                    border-bottom:1px dashed #bbf7d0;">

                            ⏱ Stop :
                            @(Math.Floor(stop_time / 60)) Hrs
                            @(Math.Floor(stop_time % 60)) Mins

                        </div>

                        cntOB++;
                    }
                }
            }

            @if (flightSearch.FlightWay == FlightWay.RoundTrip)
            {
                <!-- RETURN HEADER -->
                <div style="background:#f0f4ff;padding:7px 16px;border-top:2px solid #e2e8f0;
                border-bottom:1px solid #c7d2fe;display:flex;
                justify-content:space-between;align-items:center">

                    <span style="font-size:10px;font-weight:700;color:#4338ca;
                    text-transform:uppercase">
                        ↩ Return —
                        @flights.Inbound.First().DepartureDate.ToString("ddd, dd MMM")
                    </span>
                </div>

                {
                    int cntIB = 1;

                    foreach (var inboundArr in flights.Inbound)
                    {
                        double stop_time = 0;

                        if (cntIB < flights.Inbound.Count)
                        {
                            stop_time = double.Parse(
                                Common.GetTime(
                                    flights.Inbound[cntIB].DepartureDate,
                                    inboundArr.ArrivalDate
                                ).ToString()
                            );
                        }


                        <div class="flight-seg" style="padding:12px 16px;">

                            <div class="seg-direction"
                                 style="color:#0770e3;font-weight:600">

                                @inboundArr.FromAirport.Code →
                                @inboundArr.ToAirport.Code

                                <span style="color:#718096;font-weight:400">

                                    · @(flights.Inbound.Count - 1) stop(s)

                                    ·

                                    @(Math.Floor(double.Parse(inboundArr.TotalTime) / 60))h
                                    @(double.Parse(inboundArr.TotalTime) % 60)m

                                </span>

                            </div>

                            <div class="seg-row">

                                <div>
                                    <div class="seg-airport">
                                        @inboundArr.FromAirport.Code
                                    </div>

                                    <div class="seg-time">
                                        @inboundArr.DepartureDate.ToString("HH:mm")
                                    </div>
                                </div>

                                <div class="seg-mid-col">

                                    <div class="seg-line-wrap">

                                        <div class="s-dot"></div>

                                        <div class="s-line"></div>

                                        <div class="seg-plane">✈</div>

                                        <div class="s-line"></div>

                                        <div class="s-dot"></div>

                                    </div>

                                </div>

                                <div style="text-align:right">

                                    <div class="seg-airport">
                                        @inboundArr.ToAirport.Code
                                    </div>

                                    <div class="seg-time">
                                        @inboundArr.ArrivalDate.ToString("HH:mm")
                                    </div>

                                </div>

                            </div>

                            <div style="font-size:10px;color:#4a5568;
                    margin-top:6px;line-height:1.7">

                                Depart :
                                @inboundArr.DepartureDate.ToString("ddd, dd-MMM")

                                ·

                                Arrive :
                                @inboundArr.ArrivalDate.ToString("ddd, dd-MMM")

                                <br>

                                <b>From :</b>

                                Terminal @inboundArr.FromTerminal
                                @inboundArr.FromAirport.Name

                                <br>

                                <b>To :</b>

                                Terminal @inboundArr.ToTerminal
                                @inboundArr.ToAirport.Name

                            </div>

                            <div style="font-size:10px;color:#4a5568;margin-top:5px">

                                @inboundArr.Airline.Name

                                <span style="text-transform:uppercase">
                                    @inboundArr.CabinClass
                                </span>

                                ·

                                @inboundArr.Airline.Code-@inboundArr.FlightNo

                                <br>

                                🧳 @inboundArr.BaggageAllowance

                                Cabin : 7 KG

                            </div>

                        </div>

                        if (cntIB < flights.Inbound.Count)
                        {
                            <div style="background:#f0fdf4;
                    padding:5px 16px;
                    text-align:center;
                    font-size:10px;
                    color:#166534;
                    font-weight:600;
                    border-top:1px dashed #bbf7d0;
                    border-bottom:1px dashed #bbf7d0;">

                                ⏱ Stop :
                                @(Math.Floor(stop_time / 60)) Hrs
                                @(Math.Floor(stop_time % 60)) Mins

                            </div>

                            cntIB++;
                        }
                    }

                }
            }

            <div class="right-card">
                <div class="right-card-header">Price breakdown</div>
                <div class="fare-summary">

                    <div class="fare-row"><span>Total</span><span>@fare</span></div>
                </div>
            </div>

        </div>
    </div>

    <div class="modal fade" id="partnerModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Leaving Our Website</h5>
                </div>

                <div class="modal-body partner-body">

                    <p class="partner-message">
                        You are about to leave <strong>Faresradar</strong> and continue your booking on one of our trusted travel partners.
                    </p>

                    <div class="partner-note">
                        <strong>Important:</strong><br />
                        Flight availability, pricing, payment, and booking confirmation will be completed on the partner website.
                    </div>

                    <p class="partner-confirm">
                        Do you want to continue?
                    </p>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" data-dismiss="modal">
                        Cancel
                    </button>

                    <button class="btn btn-primary" id="continueBooking">
                        Continue
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script>
        var bookingUrl = "";

        $(".bookBtn").click(function (e) {
            debugger;
            e.preventDefault();
            var flightId = $(this).data("id");
            var site = $(this).data("site");

            bookingUrl = "/flight/RedirectToBooking?flightId=" + flightId + "&site=" + site;

            $("#partnerModal").modal("show");
        });

        $("#continueBooking").click(function () {

            $("#partnerModal").modal("hide");

            window.open(bookingUrl, "_blank");
        });

    </script>
