            }

        #skyFilterPanel .priceFilter {
            display: block !important;
            width: 100% !important;
            float: none !important;
            padding-top: 4px !important;
        }

        #skyFilterPanel .price_range {
            display: flex !important;
            justify-content: space-between !important;
            font-size: 15px !important;
            font-weight: 600 !important;
            color: #1a1a2e !important;
            margin-top: 14px !important;
        }

        #skyFilterPanel .scal_price .ui-slider-range {
            background: #1967d2 !important;
        }

        #skyFilterPanel .scal_price .ui-slider-handle {
            background: #1967d2 !important;
            border: 2px solid #fff !important;
            box-shadow: 0 1px 4px rgba(0,0,0,.3) !important;
            width: 20px !important;
            height: 20px !important;
            top: -8px !important;
        }

        #skyFilterPanel .filterFooter {
            display: flex !important;
            flex-direction: column !important;
            align-items: stretch !important;
            justify-content: flex-start !important;
            gap: 10px !important;
            padding: 16px 20px !important;
            border-top: 1px solid #ececec !important;
            background: #fff !important;
            width: 100% !important;
            max-width: 100% !important;
            box-sizing: border-box !important;
            float: none !important;
            overflow: hidden !important;
        }

            #skyFilterPanel .filterFooter a.clearFiltersLink {
                font-size: 14px !important;
                font-weight: 500 !important;
                color: #767676 !important;
                background: none !important;
                border: none !important;
                padding: 4px 0 !important;
                margin: 0 !important;
                border-radius: 0 !important;
                text-decoration: underline !important;
                text-align: center !important;
                width: 100% !important;
                box-sizing: border-box !important;
            }

            #skyFilterPanel .filterFooter a.showResultsBtn {
                background: #0b2545 !important;
                color: #fff !important;
                font-weight: 700 !important;
                font-size: 15px !important;
                padding: 12px 16px !important;
                margin: 0 !important;
                border-radius: 8px !important;
                text-decoration: none !important;
                text-align: center !important;
                white-space: nowrap !important;
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
                display: block !important;
            }

        #skyFilterPanel.filterOpen .filterFooter {
            /* no longer independently fixed - it lives inside the flex
           column below and stays pinned to the bottom of the panel,
           not the raw viewport, so it can't hide behind the mobile
           browser's own bottom bar */
            position: relative !important;
            left: auto !important;
            right: auto !important;
            bottom: auto !important;
            z-index: 999 !important;
            flex-direction: row !important;
            align-items: center !important;
            /* add safe-area padding so the button clears iPhone home
           indicator / mobile browser bottom bar */
            padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px)) !important;
        }

            #skyFilterPanel.filterOpen .filterFooter a.clearFiltersLink {
                width: auto !important;
            }

            #skyFilterPanel.filterOpen .filterFooter a.showResultsBtn {
                width: auto !important;
                flex: 1 1 auto !important;
            }

        /* ===== Make the mobile filter panel an actual full-screen,
       scrollable overlay: header fixed on top, footer fixed at
       bottom, and everything in between scrolls.
       Uses dvh (dynamic viewport height) so the panel's real height
       accounts for the mobile browser's address/toolbar - with vh
       or % alone, that bar sits on top of (and hides) the footer. ===== */
        #skyFilterPanel.filterOpen {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            height: 100vh !important;
            height: 100dvh !important;
            z-index: 1000 !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
        }

            #skyFilterPanel.filterOpen .filterHead {
                flex: 0 0 auto !important;
            }

            #skyFilterPanel.filterOpen .filterDiv {
                flex: 1 1 auto !important;
                height: auto !important;
                min-height: 0 !important;
                overflow-y: auto !important;
                -webkit-overflow-scrolling: touch !important;
            }

    body.filterBody {
        overflow: hidden !important;
        position: fixed !important;
        width: 100% !important;
    }
</style>



@if (@Model.FlightsList != null && @Model.FlightsList.Count > 0)
{
    <div class="sky-header" id="skyHeader">

        <!-- COLLAPSED STATE -->
        <div class="sky-collapsed" id="skyCollapsed" onclick="expandSearch()" style="cursor:pointer;">
            <div class="sky-pill">
                <span class="sky-pill-icon">
                    <i class="fa fa-search" style="color: white;"></i>
                </span>

                <span class="sky-pill-route">
                    @(Model.FlightsSearch.From.Code) – @(Model.FlightsSearch.To.Code)
                </span>

                <span class="sky-pill-dot">·</span>

                <span class="sky-pill-meta">
                    @(Model.FlightsSearch.DepDate.ToString("dd MMM yy"))
                    @if (Model.FlightsSearch.FlightWay == FlightWay.RoundTrip)
                    {
                        <text> - @(Model.FlightsSearch.RetDate.ToString("dd MMM yy"))</text>
                    }
                    ·
                    @Convert.ToInt32(Model.FlightsSearch.Adult + Model.FlightsSearch.Child + Model.FlightsSearch.Infant)
                    Traveller(s)
                </span>
            </div>

            <div class="sky-pill-arrow" id="toggleSearch">
                <i class="fa fa-chevron-down"></i>
            </div>
        </div>

        <!-- EXPANDED STATE: full form -->
        <div class="sky-expanded" id="skyExpanded" style="display:none">
            <!-- Trip type row -->
            <div class="sky-type-row">
                <div class="sky-type-select" id="tripTypeBtn">

                    <span id="tripTypeLabel">
                        @((ViewBag.flightWay == "OneWay") ? "→ One Way" : "↩ Round Trip")
                    </span>

                    <span class="sky-dd-arrow">
                        <i class="fa fa-chevron-down"></i>
                    </span>

                    <div class="sky-type-dropdown" id="tripTypeDropdown">

                        <label class="sky-type-opt">

                            <input type="radio"
                                   name="flight_way"
                                   id="rdoRoundtrip"
                                   class="flight_way"
                                   value="2"
