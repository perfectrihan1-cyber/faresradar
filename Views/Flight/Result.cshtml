                                <span class="sky-tr-sub">12+ Years</span>
                            </div>

                            <div class="sky-counter">

                                <a href="javascript:void(0)">
                                    <em class="fa fa-minus inc_der"
                                        data-field="adult"
                                        data-opt="-"></em>
                                </a>

                                <input type="text"
                                       readonly
                                       id="flight_adult"
                                       name="flight_adult"
                                       class="sky-counter-input inpt_cout_pssngr"
                                       value="@Model.FlightsSearch.Adult" />

                                <a href="javascript:void(0)">
                                    <em class="fa fa-plus inc_der"
                                        data-field="adult"
                                        data-opt="+"></em>
                                </a>

                            </div>

                        </div>

                        <!-- Child -->
                        <div class="sky-tr-row">

                            <div class="sky-tr-info">
                                <span class="sky-tr-type">Children</span>
                                <span class="sky-tr-sub">2-11 Years</span>
                            </div>

                            <div class="sky-counter">

                                <a href="javascript:void(0)">
                                    <em class="fa fa-minus inc_der"
                                        data-field="child"
                                        data-opt="-"></em>
                                </a>

                                <input type="text"
                                       readonly
                                       id="flight_child"
                                       name="flight_child"
                                       class="sky-counter-input inpt_cout_pssngr"
                                       value="@Model.FlightsSearch.Child" />

                                <a href="javascript:void(0)">
                                    <em class="fa fa-plus inc_der"
                                        data-field="child"
                                        data-opt="+"></em>
                                </a>

                            </div>

                        </div>

                        <!-- Infant -->
                        <div class="sky-tr-row">

                            <div class="sky-tr-info">
                                <span class="sky-tr-type">Infants</span>
                                <span class="sky-tr-sub">0-2 Years</span>
                            </div>

                            <div class="sky-counter">

                                <a href="javascript:void(0)">
                                    <em class="fa fa-minus inc_der"
                                        data-field="infant"
                                        data-opt="-"></em>
                                </a>

                                <input type="text"
                                       readonly
                                       id="flight_infant"
                                       name="flight_infant"
                                       class="sky-counter-input inpt_cout_pssngr"
                                       value="@Model.FlightsSearch.Infant" />

                                <a href="javascript:void(0)">
                                    <em class="fa fa-plus inc_der"
                                        data-field="infant"
                                        data-opt="+"></em>
                                </a>

                            </div>

                        </div>

                        <!-- Cabin -->
                        <div class="sky-cabin-row">

                            <span class="sky-tr-type">
                                Cabin class
                            </span>

                            <div class="sky-cabin-options">

                                <select id="flight_class" name="flight_class" class="sky-cabin-select">
                                    <option value="4" selected>Economy</option>
                                    <option value="3">Premium Economy</option>
                                    <option value="2">Business</option>
                                    <option value="1">First</option>
                                </select>

                            </div>

                        </div>

                        <div class="sky-tr-footer">

                            <a href="javascript:void(0)"
                               id="prsn_done"
                               class="sky-tr-done">

                                Apply

                            </a>

                        </div>

                    </div>

                </div>
            </div>

            <!-- Main form row -->
            <div class="sky-form-row">

                <!-- From -->
                <div class="sky-field sky-from">

                    <label class="sky-flabel">From</label>

                    <input type="text"
                           id="flight_from"
                           name="flight_from"
                           class="sky-finput autocomplete_from autocomplete_from_new"
                           value="@(ViewBag.fromName)"
                           placeholder="Origin"
                           autocomplete="off" />

                    <span class="sky-swap-icon" title="Swap">
                        <i class="fa fa-exchange"></i>
                    </span>

                </div>

                <!-- To -->
                <div class="sky-field sky-to">

                    <label class="sky-flabel">To</label>

                    <input type="text"
                           id="flight_to"
                           name="flight_to"
                           class="sky-finput autocomplete_to autocomplete_from_to"
                           value="@(ViewBag.toName)"
                           placeholder="Destination"
                           autocomplete="off" />

                </div>

                <!-- Departure -->

                <div class="sky-field sky-depart">

                    <label class="sky-flabel">Depart</label>

                    <input type="text"
                           id="flight_from_date"
                           name="flight_from_date"
                           class="sky-finput"
                           value="@((ViewBag.depDate!="") ? ViewBag.depDate : DateTime.Now.AddDays(1).ToString("dd-MM-yyyy"))"
                           placeholder="DD-MM-YYYY"
                           autocomplete="off"
                           readonly />



                </div>

                <!-- Return -->

                <div class="sky-field sky-return" id="returnField">

                    <label class="sky-flabel">Return</label>

                    <input type="text"
                           id="flight_to_date"
                           name="flight_to_date"
                           class="sky-finput ind_inputBox"
                           value="@((ViewBag.retDate!="") ? ViewBag.retDate : DateTime.Now.AddDays(8).ToString("dd-MM-yyyy"))"
                           placeholder="DD-MM-YYYY"
                           autocomplete="off"
                           readonly />



                </div>
                <div class="sky-search-wrap">

                    <a id="flight_submit"
                       name="flight_submit"
                       class="sky-search-btn">

                        <i class="fa fa-search"></i>
                        <span style="color:white">Search</span>

                    </a>

                </div>
            </div>



        </div>



    </div>




    <!-- ═══════════════ MAIN ═══════════════ -->
