                        </label>

                        <label class="sky-type-opt">

                            <input type="radio"
                                   name="flight_way"
                                   id="rdoOneway"
                                   class="flight_way"
                                   value="1"
                                   @((ViewBag.flightWay == "OneWay") ? "checked" : "") />

                            <span>&#8594; One way</span>

                        </label>

                    </div>

                </div>
                <div class="sky-traveller-select" id="travellerBtn">

                    <!-- Summary -->
                    <div class="sky-traveller-summary" id="prsn_add">

                        <input type="text" style="background-color: transparent; color: #f3f1ee;"
                               id="pass_info"
                               name="pass_info"
                               readonly
                               class="sky-traveller-input ind_inputBox"
                               value="@Convert.ToInt32(Model.FlightsSearch.Adult + Model.FlightsSearch.Child + Model.FlightsSearch.Infant) Traveller(s), Economy" />



                    </div>

                    <!-- Existing dropdown -->
