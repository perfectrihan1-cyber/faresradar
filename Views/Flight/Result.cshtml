<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Trip Type Dropdown
        const tripTypeBtn = document.getElementById("tripTypeBtn");
        const tripTypeDropdown = document.getElementById("tripTypeDropdown");

        if (tripTypeBtn && tripTypeDropdown) {

            tripTypeBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                tripTypeDropdown.classList.toggle("open");
            });

            tripTypeDropdown.addEventListener("click", function (e) {
                e.stopPropagation();
            });
        }

        // Traveller Dropdown
        const travellerBtn = document.getElementById("travellerBtn");
        const travellerDropdown = document.getElementById("travellerDropdown");

        if (travellerBtn && travellerDropdown) {

            travellerBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                travellerDropdown.classList.toggle("open");
            });

            travellerDropdown.addEventListener("click", function (e) {
                e.stopPropagation();
            });
        }

        // Close dropdowns when clicking outside
        document.addEventListener("click", function () {

            if (tripTypeDropdown) {
                tripTypeDropdown.classList.remove("open");
            }

            if (travellerDropdown) {
                travellerDropdown.classList.remove("open");
            }

        });

    });
</script>
